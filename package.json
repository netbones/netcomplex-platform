{
  "name": "soralia-village",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:check": "prisma generate && git diff --exit-code src/db/schema/",
    "db:seed": "pnpm exec tsx scripts/seed-drizzle.ts",
    "db:seed:village": "pnpm exec tsx scripts/seed-drizzle.ts -- --only=soralia",
    "db:seed:solaris": "pnpm exec tsx scripts/seed-drizzle.ts -- --only=solaris-heights",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "api:generate": "tsx src/server/openapi/generator.ts public/openapi.json",
    "api:lint": "redocly lint --config .redocly.yaml --format=stylish",
    "api:ci": "pnpm api:generate && pnpm api:lint",
    "events:check": "tsx scripts/check-domain-events.ts",
    "fsd:check": "steiger ./src",
    "fsd:graph": "depcruise --output-type archi --collapse 3 src | dot -T svg | depcruise-wrap-stream-in-html > fsd-high-level-dependencies.html",
    "fsd:graph:detailed": "depcruise --output-type dot --collapse 4 src | dot -T svg | depcruise-wrap-stream-in-html > fsd-detailed-dependencies.html"
  },
  "prisma": {
    "seed": "pnpm exec tsx seed.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css}": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ],
    ".planning/**/*.md": [
      "bash .husky/gsd-status-check.sh"
    ]
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@feature-sliced/steiger-plugin": "0.6.0",
    "@next/eslint-plugin-next": "^16.2.6",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/ioredis": "^5.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.2",
    "autoprefixer": "^10.4.27",
    "better-auth": "^1.6.23",
    "dependency-cruiser": "^17.4.3",
    "dotenv": "^17.4.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "eslint-plugin-boundaries": "^6.0.2",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "pdf-parse": "2.4.5",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "prisma": "5.22.0",
    "prisma-generator-drizzle": "^0.7.6",
    "shadcn": "^4.1.1",
    "steiger": "0.5.12",
    "supabase": "^2.106.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@aws-sdk/client-s3": "^3.1019.0",
    "@aws-sdk/s3-request-presigner": "^3.1019.0",
    "@better-auth/drizzle-adapter": "^1.6.23",
