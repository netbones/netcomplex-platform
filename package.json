    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.8",
    "posthog-js": "1.382.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "react-i18next": "^17.0.0",
    "react-leaflet": "^5.0.0",
    "react-rnd": "^10.5.3",
    "resend": "^6.12.2",
