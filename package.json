    "@trpc/openapi": "11.17.0-alpha",
    "@trpc/react-query": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "@types/dompurify": "^3.2.0",
    "@varlock/nextjs-integration": "^0.3.5",
    "@vercel/functions": "^3.7.5",
    "@xyflow/react": "^12.10.2",
    "codemod": "1.12.3",
    "dompurify": "^3.3.3",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "emoji-mart": "^5.6.0",
    "flags": "^4.0.6",
