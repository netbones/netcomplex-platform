{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./src/shared/*"],
      "@api/server": ["./src/shared/api/server"],
      "@api/client": ["./src/shared/api/client"],
      "@api/shared": ["./src/shared/api/shared", "./src/shared/api/shared/index"],
      "@api/shared/*": ["./src/shared/api/shared/*"],
      "@entities/*": ["./src/entities/*"],
      "@entities/tenant-module-enabled": ["./src/entities/tenant/lib/modules"],
      "@entities/tenant/server": ["./src/entities/tenant/index.server"],
      "@entities/content/server": ["./src/entities/content/index.server"],
      "@entities/maintenance/server": ["./src/entities/maintenance/index.server"],
      "@entities/event/server": ["./src/entities/event/index.server"],
      "@entities/booking/server": ["./src/entities/booking/index.server"],
      "@entities/amenity/server": ["./src/entities/amenity/index.server"],
      "@entities/security/server": ["./src/entities/security/index.server"],
      "@entities/access-control/server": ["./src/entities/access-control/index.server"],
      "@entities/dwallet/server": ["./src/entities/dwallet/index.server"],
      "@entities/dispute/server": ["./src/entities/dispute/index.server"],
      "@entities/comment/server": ["./src/entities/comment/index.server"],
      "@entities/marketplace/server": ["./src/entities/marketplace/index.server"],
      "@entities/setup/server": ["./src/entities/setup/index.server"],
      "@features/*": ["./src/features/*"],
      "@widgets/*": ["./src/widgets/*"],
      "@pages/admin/server": ["./src/page-modules/admin/server"],
      "@pages/*": ["./src/page-modules/*"],
      "@processes/*": ["./src/processes/*"],
      "@schema/*": ["./src/db/schema/*"],
      "@server/*": ["./src/server/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "src/db/schema/**/*.ts"
  ],
  "exclude": ["node_modules", "src/**/*.html", "migrate-*.ts", "docs", "scripts"]
}
