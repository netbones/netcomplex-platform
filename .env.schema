# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @defaultRequired=infer @defaultSensitive=inferFromPrefix('NEXT_PUBLIC_')
# @generateTypes(lang=ts, path=env.d.ts)
# ----------


# ─── Better Auth ───────────────────────────────────────────────
# @required @sensitive
BETTER_AUTH_SECRET=
# @required @type=url
BETTER_AUTH_URL=
# @required @type=url
NEXT_PUBLIC_BETTER_AUTH_URL=

# ─── Supabase Database ─────────────────────────────────────────
# Format: postgresql://postgres.[PROJECT_REF]:PASSWORD@aws-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# @required @sensitive @type=url
DATABASE_URL=
# @required @sensitive @type=url
DIRECT_URL=
# @required @type=url
NEXT_PUBLIC_SUPABASE_URL=
# @required
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# @sensitive
SUPABASE_SECRET_KEY=
# @sensitive
SUPABASE_SERVICE_ROLE_SECRET=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# ─── Cloudflare Turnstile (bot protection) ─────────────────────
# Get keys from https://dash.cloudflare.com/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# @sensitive @type=string(startsWith="tfk_")
TURNSTILE_SECRET_KEY=

# ─── Multi-tenant Development ──────────────────────────────────
# Required for local development to resolve tenant context
# Set to your tenant slug (e.g., 'soralia' for Soralia Village)
LOCAL_TENANT_SLUG=soralia

# ─── Tenant Location (WeatherWidget - Open-Meteo API) ──────────
# Default: Soralia Village coordinates (Stuart, FL)
# @type=number(min=-90, max=90, precision=4)
TENANT_LATITUDE=26.6619
# @type=number(min=-180, max=180, precision=4)
TENANT_LONGITUDE=-80.6128
TENANT_LOCATION_NAME=Soralia Village

# ─── Resend (transactional emails) ────────────────────────────
# Get API key from https://resend.com/api-keys
# @required @sensitive
RESEND_API_KEY=
# @type=email
RESEND_FROM_EMAIL=notifications@soralia.co.za
RESEND_FROM_NAME=Soralia Village

# ─── S3-Compatible Storage (image uploads) ─────────────────────
# @required @type=url
STORAGE_ENDPOINT=https://xxx.r2.cloudflarestorage.com
STORAGE_REGION=auto
# @required
ACCESS_KEY_ID=your-access-key
# @required @sensitive
SECRET_ACCESS_KEY=your-secret-key
# @required
STORAGE_BUCKET=content-images

# ─── App URLs ───────────────────────────────────────────────────
# @required @type=url(prependHttps=true)
NEXT_PUBLIC_APP_URL=
# @type=url(prependHttps=true)
NEXT_PUBLIC_VERCEL_URL=

# ─── Auth Configuration ────────────────────────────────────────
AUTH_COOKIE_PREFIX=soralia
AUTH_ALLOWED_HOSTS=

