# pnpm configuration for soralia-village
# See docs/advisories/ADVISORY-003.md for rationale.

# Defends against npm supply-chain poisoning: installs exactly what is
# pinned in pnpm-lock.yaml, fails loudly on drift instead of silently
# rewriting the lockfile. Belt-and-braces with --frozen-lockfile in CI.
frozen-lockfile=true

# Refuse to resolve packages published less than 1 day ago. Most
# malicious versions are caught within hours of disclosure; a one-day
# cooldown shrinks the window a bad version has to enter the lockfile.
# Does NOT affect --frozen-lockfile installs (which never re-resolve).
minimum-release-age=1d

# Do NOT set ignore-scripts=true globally — Playwright browser downloads,
# MSW service worker copy, and native-module builds rely on lifecycle
# scripts. Apply --ignore-scripts at the command level in CI and Docker
# only; allow-list rebuilds via `pnpm rebuild <pkg>`.
