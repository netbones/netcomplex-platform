# Stack Auth
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=

# Supabase Database
# Format: postgresql://postgres.[PROJECT_REF]:PASSWORD@aws-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile (for bot protection)
# Get keys from https://dash.cloudflare.com/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# S3-Compatible Storage (for image uploads) - using Supabase Storage
# Create a bucket named 'content-images' in Supabase Storage
SUPABASE_SERVICE_ROLE_KEY=