# Better Auth
BETTER_AUTH_SECRET=

# Supabase Database
# Format: postgresql://postgres.[PROJECT_REF]:PASSWORD@aws-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile (for bot protection)
# Get keys from https://dash.cloudflare.com/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

#tenant
LOCAL_TENANT_SLUG

# S3-Compatible Storage (for image uploads)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=content-images
