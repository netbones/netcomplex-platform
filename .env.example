# Better Auth
BETTER_AUTH_SECRET=

# Supabase Database
# Format: postgresql://postgres.[PROJECT_REF]:PASSWORD@aws-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile (for bot protection)
# Get keys from https://dash.cloudflare.com/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Multi-tenant Development
# Required for local development to resolve tenant context
# Set to your tenant slug (e.g., 'soralia' for Soralia Village)
LOCAL_TENANT_SLUG=soralia

# Tenant Location (for WeatherWidget - Open-Meteo API uses these)
# Default: Soralia Village coordinates (Stuart, FL)
TENANT_LATITUDE=26.6619
TENANT_LONGITUDE=-80.6128
TENANT_LOCATION_NAME=Soralia Village

# Resend (for transactional emails)
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@soralia.co.za
RESEND_FROM_NAME=Soralia Village

# S3-Compatible Storage (for image uploads)
# These are REQUIRED - validation will fail without them
STORAGE_ENDPOINT=https://xxx.r2.cloudflarestorage.com
STORAGE_REGION=auto
ACCESS_KEY_ID=your-access-key
SECRET_ACCESS_KEY=your-secret-key
STORAGE_BUCKET=content-images

# Suga Redis (rate limiting)
SUGA_REDIS_HTTPS_DOMAIN="https://your-instance.suga.run"
SUGA_REDIS_PASSWORD=""
SUGA_REDIS_PORT=6379
# Upstash Redis (rate limiting - primary)
UPSTASH_REDIS_URL="rediss://default:TOKEN@your-instance.upstash.io:6379"
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN=""

# ── Platform AI Pool ───────────────────────────────────────────
# Platform-level AI provider keys (stored in Vercel encrypted env vars).
# These are NEVER per-tenant — tenants do not hold API keys.
# Both are optional — whichever is present is used; Anthropic is preferred
# when both are available (configurable via PLATFORM_AI_DEFAULT_PROVIDER).
# Generate keys at:
#   Anthropic: https://console.anthropic.com/settings/keys
#   OpenAI:    https://platform.openai.com/api-keys
PLATFORM_ANTHROPIC_KEY=""
PLATFORM_OPENAI_KEY=""

# Default AI provider when both keys are present.
# Options: "anthropic" | "openai"
PLATFORM_AI_DEFAULT_PROVIDER="anthropic"

# Cron secret for monthly AI pool rollover (POST /api/cron/ai-pool-rollover)
# Generate: openssl rand -hex 32
CRON_SECRET=""

# ── Removed from scope (SUPPLEMENTAL-2 §1): ────────────────────
# AI_SETTINGS_ENCRYPTION_KEY — not needed (no tenant key storage)
