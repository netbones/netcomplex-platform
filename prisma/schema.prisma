generator client {
  provider = "prisma-client-js"
}

generator drizzle {
  provider = "prisma-generator-drizzle"
  output   = "../src/db/schema"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PlatformModule {
  id             String         @id @default(cuid())
  key            String         @unique
  label          String
  minTier        Tier           @default(STANDARD)
  defaultEnabled Boolean        @default(false)
  description    String?
  createdAt      DateTime       @default(now())
  tenantModules  TenantModule[]
}

model TenantModule {
  id        String         @id @default(cuid())
  tenantId  String
  moduleKey String
  enabled   Boolean        @default(false)
  config    Json?
  enabledAt DateTime?
  module    PlatformModule @relation(fields: [moduleKey], references: [key])
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
}

model AssistSession {
  id        String    @id @default(cuid())
  tenantId  String
  staffId   String
  scope     String    @default("metadata")
  expiresAt DateTime
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  revokedBy String?
  notes     String?
  staff     user      @relation(fields: [staffId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([staffId])
  @@index([expiresAt])
  @@index([isActive])
}

model Tenant {
  id               String          @id @default(uuid())
  name             String
  slug             String          @unique
  customDomain     String?         @unique
  logoUrl          String?
  faviconUrl       String?
  primaryColor     String          @default("#4F46E5")
  accentColor      String?
  secondaryColor   String?
  fontFamily       String?
  customCss        String?
  active           Boolean         @default(true)
  subscriptionTier String          @default("basic")
  modules          Json?
  maxPages         Int             @default(5)
  pageCount        Int             @default(0)
  featureFlags     Json            @default("{}")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime?
  tier             Tier            @default(STANDARD)
  ownerId          String?
  assistSessions   AssistSession[]
  owner            user?           @relation("TenantOwner", fields: [ownerId], references: [id])
  tenantModules    TenantModule[]
}

model Announcement {
  id String @id
  tenantId String
  title String
  content String
  author String
  priority String @default("normal")
  targetFilter ResidentFilter @default(ALL)
  targetRoles Role[]
  resourceId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  expiresAt DateTime?
  resource Resource? @relation(fields: [resourceId], references: [id])
}

model Booking {
  id         String        @id
  tenantId   String
  propertyId String?
  userId     String
  facility   String
  date       DateTime
  startTime  String
  endTime    String
  purpose    String?
  status     BookingStatus @default(CONFIRMED)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @default(now()) @updatedAt
  property   Property?     @relation(fields: [propertyId], references: [id])
  user       user          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Content {
  id            String          @id
  tenantId      String
  title         Json
  content       Json
  excerpt       Json?
  image         String?
  category      ContentCategory
  tags          String[]
  authorId      String?
  groupId       String?
  published     Boolean         @default(false)
  featured      Boolean         @default(false)
  priority      String          @default("normal")
  defaultLocale String          @default("en")
  contentType   String          @default("article")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt
  publishedAt   DateTime?
  expiresAt     DateTime?
  user          user?           @relation(fields: [authorId], references: [id])
  Group         Group?          @relation(fields: [groupId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Conversation {
  id                      String                    @id
  tenantId                String
  name                    String?
  type                    ConversationType          @default(DIRECT)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now()) @updatedAt
  ConversationParticipant ConversationParticipant[]
  Message                 Message[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ConversationParticipant {
  id                String       @id
  tenantId          String
  conversationId    String
  userId            String
  joinedAt          DateTime     @default(now())
  lastReadAt        DateTime?
  lastReadMessageId String?
  Conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              user         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Competition {
  id              String            @id @default(cuid())
  tenantId        String
  title           String
  description     String?
  rules           String?
  prizeInfo       String?
  startDate       DateTime
  endDate         DateTime
  status          CompetitionStatus @default(DRAFT)
  entryCount      Int               @default(0)
  type            CompetitionType   @default(RAFFLE)
  winnersCount    Int               @default(1)
  maxParticipants Int?
  image           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  entries         CompetitionEntry[]

  @@index([tenantId])
  @@index([status])
}

model CompetitionEntry {
  id             String        @id @default(cuid())
  competitionId  String
  userId         String
  status         EntryStatus   @default(JOINED)
  joinedAt       DateTime      @default(now())
  submissionUrl  String?       // For PHOTO type — entry photo URL
  submissionText String?       // For PHOTO type — optional description
  score          Float?        // For SCORE type — admin-assigned score
  winnerAt       DateTime?     // When marked as winner
  prize          String?       // What they won
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        user        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([competitionId])
  @@index([userId])
  @@index([status])
}

model Event {
  id          String           @id
  tenantId    String
  title       String
  description String
  date        DateTime
  location    String
  organizer   String
  image       String?
  isPublic    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  attendees   EventAttendee[]

  @@index([tenantId])
}

model EventAttendee {
  id        String   @id
  tenantId  String
  eventId   String
  userId    String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model ExternalSurvey {
  id         String   @id
  tenantId   String
  name       String
  provider   String
  externalId String
  embedUrl   String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
}

model Group {
  id                     String                   @id
  tenantId               String
  name                   String
  description            String?
  category               String
  image                  String?
  color                  String                   @default("#4F46E5")
  isPublic               Boolean                  @default(true)
  accessType             GroupAccess              @default(OPEN)
  residentFilter         ResidentFilter           @default(ALL)
  isActive               Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @default(now()) @updatedAt
  deletedAt              DateTime?
  ownerId                String
  Content                Content[]
  user                   user                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  GroupMembershipRequest GroupMembershipRequest[]
  UserGroup              UserGroup[]
}

model GroupMembershipRequest {
  id        String           @id
  tenantId  String
  userId    String
  groupId   String
  status    MembershipStatus @default(PENDING)
  message   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt
  Group     Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      user             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId, status])
}

model MaintenanceRequest {
  id                   String         @id
  tenantId             String
  propertyId           String?
  userId               String
  category             String
  priority             Priority
  description          String
  status               RequestStatus  @default(SUBMITTED)
  images               String[]
  assignedTo           String?
  vendor               String?
  scheduledDate        DateTime?
  estimatedCost        Decimal?       @db.Decimal(10, 2)
  actualCost           Decimal?       @db.Decimal(10, 2)
  resolution           String?
  completedAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @default(now()) @updatedAt
  ticketNumber         String
  preferredDate        DateTime?
  preferredTime        String?
  assignedTeamId       String?
  assignedProviderId   String?
  property             Property?      @relation(fields: [propertyId], references: [id])
  user                 user           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTeam         MaintenanceTeam?   @relation("TeamAssignments", fields: [assignedTeamId], references: [id])
  assignedProvider     ServiceProvider?   @relation("ProviderAssignments", fields: [assignedProviderId], references: [id])
  histories            RequestHistory[]
  notes                RequestNote[]

  @@index([tenantId])
  @@index([assignedTeamId])
  @@index([assignedProviderId])
}

model MaintenanceTeam {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  trade       String
  contactName String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  assignments MaintenanceRequest[] @relation("TeamAssignments")

  @@index([tenantId])
}

model ServiceProvider {
  id          String   @id @default(cuid())
  tenantId    String
  companyName String
  contactName String?
  phone       String?
  email       String?
  trade       String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  assignments MaintenanceRequest[] @relation("ProviderAssignments")

  @@index([tenantId])
}

model MaintenanceCategory {
  id          String   @id @default(cuid())
  tenantId    String
  value       String
  label       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([tenantId, value])
  @@index([tenantId])
}

model RequestNote {
  id         String   @id @default(cuid())
  requestId  String
  userId     String
  content    String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  request    MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user       user @relation(fields: [userId], references: [id])

  @@index([requestId])
}

model RequestHistory {
  id        String   @id @default(cuid())
  requestId String
  userId    String
  field     String
  oldValue  String?
  newValue  String?
  comment   String?
  createdAt DateTime @default(now())
  request   MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      user @relation(fields: [userId], references: [id])

  @@index([requestId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Message {
  id             String       @id
  tenantId       String
  conversationId String
  senderId       String
  content        String
  type           MessageType  @default(TEXT)
  createdAt      DateTime     @default(now())
  expiresAt      DateTime?
  isDeleted      Boolean      @default(false)
  mediaUrl       String?
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           user         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([expiresAt])
}

model Notification {
  id        String   @id
  tenantId  String
  userId    String
  title     String
  message   String
  type      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}

model Question {
  id        String         @id
  tenantId  String
  surveyId  String
  sectionId String?
  text      String
  type      QuestionType
  options   String[]
  required  Boolean        @default(false)
  order     Int            @default(0)
  config    Json?          @default("{}")
  Survey    Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  Section   SurveySection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([surveyId])
  @@index([sectionId])
}

model Response {
  id        String   @id
  tenantId  String
  surveyId  String
  userId    String?
  answers   Json
  createdAt DateTime @default(now())
  Survey    Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
}

model Setting {
  id       String @id
  tenantId String
  key      String
  value    String

  @@unique([tenantId, key])
}

model SurveySection {
  id          String     @id
  tenantId    String
  surveyId    String
  title       String?
  description String?
  image       String?
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  Survey      Survey     @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  Question    Question[]

  @@index([surveyId])
}

model Survey {
  id          String          @id
  tenantId    String
  title       String
  description String?
  type        SurveyType      @default(INTERNAL)
  status      SurveyStatus    @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  config      Json?           @default("{}")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
  Question    Question[]
  Response    Response[]
  Section     SurveySection[]
}

model UserGroup {
  id       String    @id
  tenantId String
  userId   String
  groupId  String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())
  Group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model account {
  id                    String    @id
  tenantId              String?
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model agentAccess {
  id                                 String            @id
  tenantId                           String
  agentId                            String
  propertyId                         String
  grantedById                        String
  accessLevel                        AgentAccessLevel  @default(MANAGEMENT)
  permissions                        AgentPermission[]
  startedAt                          DateTime          @default(now())
  expiresAt                          DateTime
  isActive                           Boolean           @default(true)
  commissionRate                     Decimal?          @db.Decimal(5, 2)
  contractTerms                      String?
  organizationId                     String?
  createdAt                          DateTime          @default(now())
  updatedAt                          DateTime          @default(now()) @updatedAt
  user_agentAccess_agentIdTouser     user              @relation("agentAccess_agentIdTouser", fields: [agentId], references: [id])
  user_agentAccess_grantedByIdTouser user              @relation("agentAccess_grantedByIdTouser", fields: [grantedById], references: [id])
  property                           Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([expiresAt])
  @@index([propertyId])
  @@index([organizationId])
}

model agentProfile {
  id               String    @id
  tenantId         String
  agentId          String    @unique
  agencyName       String?
  licenseNumber    String?
  experienceYears  Int       @default(0)
  specializations  String[]
  serviceAreas     String[]
  totalListings    Int       @default(0)
  activeListings   Int       @default(0)
  salesCompleted   Int       @default(0)
  avgSalePrice     Decimal?  @db.Decimal(12, 2)
  rating           Float     @default(0)
  reviewCount      Int       @default(0)
  commissionRate   Decimal?  @db.Decimal(5, 2)
  responseTime     Int       @default(24)
  isVerified       Boolean   @default(false)
  verificationDate DateTime?
  organizationId   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  user             user      @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([isVerified])
  @@index([organizationId])
  @@index([rating])
}

model album {
  id          String   @id
  tenantId    String
  userId      String
  title       String
  description String?
  isPublic    Boolean  @default(false)
  mediaIds    String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  user        user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isPublic])
  @@index([userId])
}

model communityServiceInquiry {
  id                      String                  @id
  tenantId                String
  listingId               String
  inquirerId              String
  serviceType             String?
  preferredDate           DateTime?
  preferredTime           String?
  location                String?
  description             String
  contactMethod           String                  @default("PLATFORM_MESSAGE")
  status                  InquiryStatus           @default(PENDING)
  providerResponse        String?
  respondedAt             DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @default(now()) @updatedAt
  user                    user                    @relation(fields: [inquirerId], references: [id])
  communityServiceListing communityServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([inquirerId])
  @@index([listingId])
  @@index([status])
}

model communityServiceListing {
  id                      String                    @id
  tenantId                String
  providerId              String
  title                   String
  description             String?
  category                ServiceCategory
  subcategory             String?
  priceType               PriceType
  price                   Decimal?                  @db.Decimal(10, 2)
  currency                String                    @default("ZAR")
  serviceAreas            String[]
  availability            Json?
  licenseNumber           String?
  insuranceExpiry         DateTime?
  verified                Boolean                   @default(false)
  verificationDate        DateTime?
  responseTime            Int                       @default(24)
  contactMethods          String[]
  images                  String[]
  portfolio               String[]
  status                  ListingStatus             @default(DRAFT)
  isPublished             Boolean                   @default(false)
  isFeatured              Boolean                   @default(false)
  moderatedBy             String?
  moderatedAt             DateTime?
  moderationNotes         String?
  rating                  Float                     @default(0)
  reviewCount             Int                       @default(0)
  termsAndConditions      String?
  cancellationPolicy      String?
  organizationId          String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now()) @updatedAt
  communityServiceInquiry communityServiceInquiry[]
  user                    user                      @relation(fields: [providerId], references: [id])
  communityServiceReview  communityServiceReview[]

  @@index([category])
  @@index([isPublished])
  @@index([organizationId])
  @@index([providerId])
  @@index([status])
  @@index([verified])
}

model communityServiceReview {
  id                      String                  @id
  tenantId                String
  listingId               String
  reviewerId              String
  rating                  Int
  title                   String?
  comment                 String?
  serviceDate             DateTime?
  responseQuality         Int?
  isPublished             Boolean                 @default(true)
  moderatedBy             String?
  moderatedAt             DateTime?
  createdAt               DateTime                @default(now())
  communityServiceListing communityServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user                    user                    @relation(fields: [reviewerId], references: [id])

  @@index([listingId])
  @@index([rating])
  @@index([reviewerId])
}

model Property {
  id                 String               @id @default(cuid())
  tenantId           String
  platformAddress    String               @unique
  street             String
  unit               String
  ownerId            String?
  homeImage          String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  Booking            Booking[]
  households         Household[]
  MaintenanceRequest MaintenanceRequest[]
  owner              user?                @relation("PropertyOwner", fields: [ownerId], references: [id])
  agentAccess        agentAccess[]
  propertyListing    propertyListing[]
  soloSeat           soloSeat[]
  standardSeat       standardSeat[]
  premiumSeat        premiumSeat[]        @relation("PremiumSeatPortfolio")

  @@unique([street, unit])
  @@index([ownerId])
  @@index([platformAddress])
}

model Household {
  id             String          @id @default(cuid())
  tenantId       String
  propertyId     String
  organizationId String?
  occupancyType  OccupancyType   @default(OWNER_OCCUPIED)
  status         HouseholdStatus @default(ACTIVE)
  moveInDate     DateTime?
  moveOutDate    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  profiles       profile[]

  @@index([propertyId])
  @@index([organizationId])
}

model invitation {
  id             String           @id
  tenantId       String
  email          String           @unique
  name           String
  street         String?
  unit           String?
  residentType   ResidentType     @default(OWNER)
  role           Role             @default(RESIDENT)
  token          String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @default(now())
  createdAt      DateTime         @default(now())
  organizationId String
  inviterId      String
  user           user             @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  organization   organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId])
}

model member {
  id             String       @id
  tenantId       String
  organizationId String
  userId         String
  role           String       @default("member")
  createdAt      DateTime
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           user         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
}

model organization {
  id         String       @id
  tenantId   String
  name       String
  slug       String       @unique
  logo       String?
  createdAt  DateTime
  metadata   String?
  invitation invitation[]
  member     member[]
}

model passkey {
  id           String    @id
  tenantId     String
  name         String?
  publicKey    String
  userId       String
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?
  user         user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([credentialID])
  @@index([userId])
}

model platformSuspension {
  id             String         @id
  tenantId       String
  userId         String
  suspensionType SuspensionType
  reason         String
  description    String?
  startDate      DateTime       @default(now())
  endDate        DateTime?
  isPermanent    Boolean        @default(false)
  isActive       Boolean        @default(true)
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
  user           user           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([userId])
}

model premiumSeat {
  id                   String     @id
  tenantId             String
  userId               String     @unique
  isActive             Boolean    @default(true)
  portfolioName        String?
  subscriptionTier     String     @default("basic")
  maxProperties        Int        @default(5)
  platformAddress      String     @unique
  organizationId       String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @default(now()) @updatedAt
  messageRetentionDays Int        @default(30)
  tier                 String     @default("foundation")
  user                 user       @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties           Property[] @relation("PremiumSeatPortfolio")

  @@index([organizationId])
  @@index([userId])
}

model profile {
  id                            String        @id
  tenantId                      String
  householdId                   String
  displayName                   String
  profileAddress                String        @unique
  userId                        String?
  avatar                        String?
  isPublic                      Boolean       @default(true)
  showEmail                     Boolean       @default(true)
  showPhone                     Boolean       @default(true)
  occupantSince                 DateTime      @default(now())
  occupantType                  OccupantType  @default(OCCUPANT)
  leaseStartDate                DateTime?
  leaseEndDate                  DateTime?
  status                        ProfileStatus @default(ACTIVE)
  organizationId                String?
  createdAt                     DateTime      @default(now())
  updatedAt                     DateTime      @default(now()) @updatedAt
  occupantImage                 String?
  rentalImage                   String?
  landlordId                    String?
  residencyType                 ResidencyType @default(FAMILY)
  household                     Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user_profile_landlordIdTouser user?         @relation("profile_landlordIdTouser", fields: [landlordId], references: [id])
  user_profile_userIdTouser     user?         @relation("profile_userIdTouser", fields: [userId], references: [id])

  @@unique([householdId, profileAddress])
  @@index([householdId])
  @@index([landlordId])
  @@index([organizationId])
  @@index([userId])
}

model propertyListing {
  id                                         String        @id
  tenantId                                   String
  propertyId                                 String
  ownerId                                    String
  listingType                                ListingType
  title                                      String
  description                                String?
  price                                      Decimal?      @db.Decimal(10, 2)
  currency                                   String        @default("ZAR")
  bedrooms                                   Int?
  bathrooms                                  Int?
  parkingSpaces                              Int?
  gardenSize                                 Float?
  petFriendly                                Boolean       @default(false)
  status                                     ListingStatus @default(DRAFT)
  isPublished                                Boolean       @default(false)
  isFeatured                                 Boolean       @default(false)
  assignedAgentId                            String?
  marketingBudget                            Decimal?      @db.Decimal(10, 2)
  featuredUntil                              DateTime?
  organizationId                             String?
  createdAt                                  DateTime      @default(now())
  updatedAt                                  DateTime      @default(now()) @updatedAt
  user_propertyListing_assignedAgentIdTouser user?         @relation("propertyListing_assignedAgentIdTouser", fields: [assignedAgentId], references: [id])
  user_propertyListing_ownerIdTouser         user          @relation("propertyListing_ownerIdTouser", fields: [ownerId], references: [id])
  property                                   Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([assignedAgentId])
  @@index([propertyId])
  @@index([isPublished])
  @@index([listingType])
  @@index([organizationId])
  @@index([ownerId])
  @@index([status])
}

model session {
  id                   String   @id
  tenantId             String?
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  impersonatedBy       String?
  user                 user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model soloSeat {
  id                  String       @id
  tenantId            String
  userId              String
  platformAddress     String       @unique
  propertyId          String?
  seatType            SoloSeatType
  isComplimentary     Boolean      @default(false)
  linkedFromProfileId String?
  organizationId      String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @default(now()) @updatedAt
  property            Property?    @relation(fields: [propertyId], references: [id])
  user                user         @relation(fields: [userId], references: [id])

  @@index([propertyId])
  @@index([organizationId])
}

model standardSeat {
  id              String   @id
  tenantId        String
  userId          String
  propertyId      String
  isPrimaryOwner  Boolean  @default(true)
  platformAddress String   @unique
  organizationId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user            user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([propertyId])
  @@index([organizationId])
  @@index([userId])
}

model twoFactor {
  id          String @id
  tenantId    String
  secret      String
  backupCodes String
  userId      String
  user        user   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
}

model user {
  id                                                    String                    @id
  tenantId                                              String
  email                                                 String                    @unique
  name                                                  String
  role                                                  Role                      @default(RESIDENT)
  isActive                                              Boolean                   @default(true)
  phone                                                 String?
  interests                                             String[]
  avatar                                                String?
  profileImage                                          String?
  books                                                 Json?                     @default("[]")
  dashboardLayout                                       Json?                     @default("null")
  isPublic                                              Boolean                   @default(true)
  showEmail                                             Boolean                   @default(true)
  showPhone                                             Boolean                   @default(true)
  profileSlug                                           String?
  createdAt                                             DateTime                  @default(now())
  updatedAt                                             DateTime                  @default(now()) @updatedAt
  emailVerified                                         Boolean                   @default(false)
  image                                                 String?
  twoFactorEnabled                                      Boolean?                  @default(false)
  isPlatformAdmin                                       Boolean                   @default(false)
  assistSessions                                        AssistSession[]
  Booking                                               Booking[]
  CompetitionEntry                                      CompetitionEntry[]
  Content                                               Content[]
  EventAttendee                                         EventAttendee[]
  ConversationParticipant                               ConversationParticipant[]
  Group                                                 Group[]
  GroupMembershipRequest                                GroupMembershipRequest[]
  MaintenanceRequest MaintenanceRequest[]
  RequestNote RequestNote[]
  RequestHistory RequestHistory[]
  Message Message[]
  Notification                                          Notification[]
  ownedProperties                                       Property[]                @relation("PropertyOwner")
  Resource                                              Resource[]
  ownedTenants                                          Tenant[]                  @relation("TenantOwner")
  UserGroup                                             UserGroup[]
  account                                               account[]
  agentAccess_agentAccess_agentIdTouser                 agentAccess[]             @relation("agentAccess_agentIdTouser")
  agentAccess_agentAccess_grantedByIdTouser             agentAccess[]             @relation("agentAccess_grantedByIdTouser")
  agentProfile                                          agentProfile?
  album                                                 album[]
  communityServiceInquiry                               communityServiceInquiry[]
  communityServiceListing                               communityServiceListing[]
  communityServiceReview                                communityServiceReview[]
  invitation                                            invitation[]
  member                                                member[]
  passkey                                               passkey[]
  platformSuspension                                    platformSuspension[]
  premiumSeat                                           premiumSeat?
  profile_profile_landlordIdTouser                      profile[]                 @relation("profile_landlordIdTouser")
  profile_profile_userIdTouser                          profile[]                 @relation("profile_userIdTouser")
  propertyListing_propertyListing_assignedAgentIdTouser propertyListing[]         @relation("propertyListing_assignedAgentIdTouser")
  propertyListing_propertyListing_ownerIdTouser         propertyListing[]         @relation("propertyListing_ownerIdTouser")
  session                                               session[]
  soloSeat                                              soloSeat[]
  standardSeat                                          standardSeat[]
  twoFactor                                             twoFactor[]
}

model verification {
  id         String   @id
  tenantId   String?
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

model Resource {
  id          String             @id @default(cuid())
  tenantId    String
  title       String
  description String?
  category    ResourceCategory
  fileUrl     String?
  fileType    String?
  fileSize    Int?
  externalUrl String?
  bodyContent Json?
  version     String?
  downloadCount Int              @default(0)
  visibility  ResourceVisibility @default(ALL_RESIDENTS)
  authorId    String?
  publishedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        user?              @relation(fields: [authorId], references: [id])

  versions    ResourceVersion[]

  @@index([tenantId])
  @@index([category])
  @@index([visibility])
  announcements Announcement[]
}

model ResourceVersion {
  id         String   @id @default(cuid())
  resourceId String
  fileUrl    String?
  fileType   String?
  fileSize   Int?
  version    String?
  notes      String?
  createdAt  DateTime @default(now())

  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
}

