generator client {
  provider = "prisma-client-js"
}

generator drizzle {
  provider = "prisma-generator-drizzle"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id              String    @id
  name            String
  slug            String    @unique
  customDomain    String?   @unique
  logoUrl         String?
  faviconUrl      String?
  primaryColor   String    @default("#4F46E5")
  accentColor     String?
  secondaryColor  String?
  fontFamily      String?
  customCss       String?
  active          Boolean   @default(true)
  
  // Subscription
  subscriptionTier String   @default("sprout") // sprout, grove, forest
  modules          Json?    // Optional custom module bundle, e.g., ["directory", "bookings", "chat"]
  maxPages          Int      @default(5)
  pageCount         Int      @default(0)
  featureFlags      Json     @default("{}")
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime?
}

model Announcement {
  id        String    @id
  tenantId  String
  title     String
  content   String
  author    String
  priority  String    @default("normal")
  createdAt DateTime  @default(now())
  expiresAt DateTime?
}

model Booking {
  id        String        @id
  tenantId  String
  userId    String
  facility  String
  date      DateTime
  startTime String
  endTime   String
  purpose   String?
  status    BookingStatus @default(CONFIRMED)
  createdAt DateTime      @default(now())
  updatedAt DateTime
  user      user          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Content {
  id            String          @id
  tenantId      String
  title         Json            // { "en": "Title", "af": "Titel" }
  content       Json            // { "en": "<p>...</p>", "af": "<p>...</p>" }
  excerpt       Json?           // { "en": "...", "af": "..." }
  image         String?
  category      ContentCategory
  tags          String[]
  authorId      String?
  groupId       String?
  published     Boolean         @default(false)
  featured      Boolean         @default(false)
  priority      String          @default("normal")
  defaultLocale String          @default("en")  // Fallback locale
  contentType   String          @default("article")  // "article" or "campaign"
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  publishedAt   DateTime?
  expiresAt     DateTime?
  user          user?           @relation(fields: [authorId], references: [id])
  Group         Group?          @relation(fields: [groupId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Conversation {
  id                      String                    @id
  tenantId  String
  name                    String?
  type                    ConversationType          @default(DIRECT)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  ConversationParticipant ConversationParticipant[]
  Message                 Message[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ConversationParticipant {
  id                String       @id
  tenantId  String
  conversationId    String
  userId            String
  joinedAt          DateTime     @default(now())
  lastReadAt        DateTime?
  lastReadMessageId String?
  Conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              user         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Event {
  id          String   @id
  tenantId  String
  title       String
  description String
  date        DateTime
  location    String
  organizer   String
  image       String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model ExternalSurvey {
  id         String   @id
  tenantId  String
  name       String
  provider   String
  externalId String
  embedUrl   String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
}

model Group {
  id                     String                   @id
  tenantId  String
  name                   String
  description            String?
  category               String
  image                  String?
  color                  String                   @default("#4F46E5")
  isPublic               Boolean                  @default(true)
  accessType             GroupAccess              @default(OPEN)
  residentFilter         ResidentFilter           @default(ALL)
  isActive               Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  deletedAt              DateTime?
  ownerId                String
  Content                Content[]
  user                   user                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  GroupMembershipRequest GroupMembershipRequest[]
  UserGroup              UserGroup[]
}

model GroupMembershipRequest {
  id        String           @id
  tenantId  String
  userId    String
  groupId   String
  status    MembershipStatus @default(PENDING)
  message   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime
  Group     Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      user             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId, status])
}

model MaintenanceRequest {
  id          String        @id
  tenantId  String
  userId      String
  category    String
  priority    Priority
  description String
  status      RequestStatus @default(SUBMITTED)
  images      String[]
  assignedTo  String?
  vendor      String?
  scheduledDate DateTime?
  estimatedCost Decimal?    @db.Decimal(10, 2)
  actualCost   Decimal?    @db.Decimal(10, 2)
  resolution  String?
  completedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  user        user          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Message {
  id             String       @id
  tenantId  String
  conversationId String
  senderId       String
  content        String
  type           MessageType  @default(TEXT)
  createdAt      DateTime     @default(now())
  expiresAt      DateTime?
  isDeleted      Boolean      @default(false)
  mediaUrl       String?
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           user         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([expiresAt])
}

model Notification {
  id        String   @id
  tenantId  String
  userId    String
  title     String
  message   String
  type      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Question {
  id       String       @id
  tenantId  String
  surveyId String
  text     String
  type     QuestionType
  options  String[]
  required Boolean      @default(false)
  order    Int          @default(0)
  Survey   Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
}

model Response {
  id        String   @id
  tenantId  String
  surveyId  String
  userId    String?
  answers   Json
  createdAt DateTime @default(now())
  Survey    Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
}

model Setting {
  id    String @id
  tenantId  String
  key   String @unique
  value String
}

model Survey {
  id          String       @id
  tenantId  String
  title       String
  description String?
  type        SurveyType   @default(INTERNAL)
  status      SurveyStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime
  Question    Question[]
  Response    Response[]
}

model UserGroup {
  id       String    @id
  tenantId  String
  userId   String
  groupId  String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())
  Group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model account {
  id                    String    @id
  tenantId              String?
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model agentAccess {
  id                                 String            @id
  tenantId  String
  agentId                            String
  householdId                        String
  grantedById                        String
  accessLevel                        AgentAccessLevel  @default(MANAGEMENT)
  permissions                        AgentPermission[]
  startedAt                          DateTime          @default(now())
  expiresAt                          DateTime
  isActive                           Boolean           @default(true)
  commissionRate                     Decimal?          @db.Decimal(5, 2)
  contractTerms                      String?
  organizationId                     String?
  createdAt                          DateTime          @default(now())
  updatedAt                          DateTime
  user_agentAccess_agentIdTouser     user              @relation("agentAccess_agentIdTouser", fields: [agentId], references: [id])
  user_agentAccess_grantedByIdTouser user              @relation("agentAccess_grantedByIdTouser", fields: [grantedById], references: [id])
  household                          household         @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([expiresAt])
  @@index([householdId])
  @@index([organizationId])
}

model agentProfile {
  id               String    @id
  tenantId  String
  agentId          String    @unique
  agencyName       String?
  licenseNumber    String?
  experienceYears  Int       @default(0)
  specializations  String[]
  serviceAreas     String[]
  totalListings    Int       @default(0)
  activeListings   Int       @default(0)
  salesCompleted   Int       @default(0)
  avgSalePrice     Decimal?  @db.Decimal(12, 2)
  rating           Float     @default(0)
  reviewCount      Int       @default(0)
  commissionRate   Decimal?  @db.Decimal(5, 2)
  responseTime     Int       @default(24)
  isVerified       Boolean   @default(false)
  verificationDate DateTime?
  organizationId   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  user             user      @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([isVerified])
  @@index([organizationId])
  @@index([rating])
}

model album {
  id          String   @id
  tenantId  String
  userId      String
  title       String
  description String?
  isPublic    Boolean  @default(false)
  mediaIds    String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  user        user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isPublic])
  @@index([userId])
}

model communityServiceInquiry {
  id                      String                  @id
  tenantId  String
  listingId               String
  inquirerId              String
  serviceType             String?
  preferredDate           DateTime?
  preferredTime           String?
  location                String?
  description             String
  contactMethod           String                  @default("PLATFORM_MESSAGE")
  status                  InquiryStatus           @default(PENDING)
  providerResponse        String?
  respondedAt             DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime
  user                    user                    @relation(fields: [inquirerId], references: [id])
  communityServiceListing communityServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([inquirerId])
  @@index([listingId])
  @@index([status])
}

model communityServiceListing {
  id                      String                    @id
  tenantId  String
  providerId              String
  title                   String
  description             String?
  category                ServiceCategory
  subcategory             String?
  priceType               PriceType
  price                   Decimal?                  @db.Decimal(10, 2)
  currency                String                    @default("ZAR")
  serviceAreas            String[]
  availability            Json?
  licenseNumber           String?
  insuranceExpiry         DateTime?
  verified                Boolean                   @default(false)
  verificationDate        DateTime?
  responseTime            Int                       @default(24)
  contactMethods          String[]
  images                  String[]
  portfolio               String[]
  status                  ListingStatus             @default(DRAFT)
  isPublished             Boolean                   @default(false)
  isFeatured              Boolean                   @default(false)
  moderatedBy             String?
  moderatedAt             DateTime?
  moderationNotes         String?
  rating                  Float                     @default(0)
  reviewCount             Int                       @default(0)
  termsAndConditions      String?
  cancellationPolicy      String?
  organizationId          String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  communityServiceInquiry communityServiceInquiry[]
  user                    user                      @relation(fields: [providerId], references: [id])
  communityServiceReview  communityServiceReview[]

  @@index([category])
  @@index([isPublished])
  @@index([organizationId])
  @@index([providerId])
  @@index([status])
  @@index([verified])
}

model communityServiceReview {
  id                      String                  @id
  tenantId  String
  listingId               String
  reviewerId              String
  rating                  Int
  title                   String?
  comment                 String?
  serviceDate             DateTime?
  responseQuality         Int?
  isPublished             Boolean                 @default(true)
  moderatedBy             String?
  moderatedAt             DateTime?
  createdAt               DateTime                @default(now())
  communityServiceListing communityServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user                    user                    @relation(fields: [reviewerId], references: [id])

  @@index([listingId])
  @@index([rating])
  @@index([reviewerId])
}

model household {
  id              String            @id
  tenantId  String
  organizationId  String?
  street          String
  unit            String
  platformAddress String            @unique
  homeImage       String?
  status          HouseholdStatus   @default(ACTIVE)
  moveInDate      DateTime?
  moveOutDate     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  agentAccess     agentAccess[]
  profile         profile[]
  propertyListing propertyListing[]
  soloSeat        soloSeat[]
  standardSeat    standardSeat[]
  premiumSeat     premiumSeat[]     @relation("PremiumSeatPortfolio")

  @@unique([street, unit])
  @@index([organizationId])
  @@index([platformAddress])
}

model invitation {
  id             String           @id
  tenantId  String
  email          String           @unique
  name           String
  street         String?
  unit           String?
  residentType   ResidentType     @default(OWNER)
  role           Role             @default(RESIDENT)
  token          String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @default(now())
  createdAt      DateTime         @default(now())
  organizationId String
  inviterId      String
  user           user             @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  organization   organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId])
}

model member {
  id             String       @id
  tenantId  String
  organizationId String
  userId         String
  role           String       @default("member")
  createdAt      DateTime
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           user         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
}

model organization {
  id         String       @id
  tenantId  String
  name       String
  slug       String       @unique
  logo       String?
  createdAt  DateTime
  metadata   String?
  invitation invitation[]
  member     member[]
}

model passkey {
  id           String    @id
  tenantId  String
  name         String?
  publicKey    String
  userId       String
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?
  user         user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([credentialID])
  @@index([userId])
}

model platformSuspension {
  id             String         @id
  tenantId  String
  userId         String
  suspensionType SuspensionType
  reason         String
  description    String?
  startDate      DateTime       @default(now())
  endDate        DateTime?
  isPermanent    Boolean        @default(false)
  isActive       Boolean        @default(true)
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  user           user           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([userId])
}

model premiumSeat {
  id                   String      @id
  tenantId  String
  userId               String      @unique
  isActive             Boolean     @default(true)
  portfolioName        String?
  subscriptionTier     String      @default("basic")
  maxProperties        Int         @default(5)
  platformAddress      String      @unique
  organizationId       String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime
  messageRetentionDays Int         @default(30)
  tier                 String      @default("foundation")
  user                 user        @relation(fields: [userId], references: [id], onDelete: Cascade)
  household            household[] @relation("PremiumSeatPortfolio")

  @@index([organizationId])
  @@index([userId])
}

model profile {
  id                            String        @id
  tenantId  String
  householdId                   String
  displayName                   String
  profileAddress                String        @unique
  userId                        String?
  avatar                        String?
  isPublic                      Boolean       @default(true)
  showEmail                     Boolean       @default(true)
  showPhone                     Boolean       @default(true)
  occupantSince                 DateTime      @default(now())
  occupantType                  OccupantType  @default(OCCUPANT)
  leaseStartDate                DateTime?
  leaseEndDate                  DateTime?
  status                        ProfileStatus @default(ACTIVE)
  organizationId                String?
  createdAt                     DateTime      @default(now())
  updatedAt                     DateTime
  occupantImage                 String?
  rentalImage                   String?
  landlordId                    String?
  residencyType                 ResidencyType @default(FAMILY)
  household                     household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user_profile_landlordIdTouser user?         @relation("profile_landlordIdTouser", fields: [landlordId], references: [id])
  user_profile_userIdTouser     user?         @relation("profile_userIdTouser", fields: [userId], references: [id])

  @@unique([householdId, profileAddress])
  @@index([householdId])
  @@index([landlordId])
  @@index([organizationId])
  @@index([userId])
}

model propertyListing {
  id                                         String        @id
  tenantId  String
  householdId                                String
  ownerId                                    String
  listingType                                ListingType
  title                                      String
  description                                String?
  price                                      Decimal?      @db.Decimal(10, 2)
  currency                                   String        @default("ZAR")
  bedrooms                                   Int?
  bathrooms                                  Int?
  parkingSpaces                              Int?
  gardenSize                                 Float?
  petFriendly                                Boolean       @default(false)
  status                                     ListingStatus @default(DRAFT)
  isPublished                                Boolean       @default(false)
  isFeatured                                 Boolean       @default(false)
  assignedAgentId                            String?
  marketingBudget                            Decimal?      @db.Decimal(10, 2)
  featuredUntil                              DateTime?
  organizationId                             String?
  createdAt                                  DateTime      @default(now())
  updatedAt                                  DateTime
  user_propertyListing_assignedAgentIdTouser user?         @relation("propertyListing_assignedAgentIdTouser", fields: [assignedAgentId], references: [id])
  household                                  household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user_propertyListing_ownerIdTouser         user          @relation("propertyListing_ownerIdTouser", fields: [ownerId], references: [id])

  @@index([assignedAgentId])
  @@index([householdId])
  @@index([isPublished])
  @@index([listingType])
  @@index([organizationId])
  @@index([ownerId])
  @@index([status])
}

model session {
  id                   String   @id
  tenantId             String?
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  impersonatedBy       String?
  user                 user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model soloSeat {
  id                  String       @id
  tenantId  String
  userId              String       @unique
  platformAddress     String       @unique
  householdId         String?
  seatType            SoloSeatType
  isComplimentary     Boolean      @default(false)
  linkedFromProfileId String?
  organizationId      String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime
  household           household?   @relation(fields: [householdId], references: [id])
  user                user         @relation(fields: [userId], references: [id])

  @@index([householdId])
  @@index([organizationId])
}

model standardSeat {
  id              String    @id
  tenantId  String
  userId          String
  householdId     String
  isPrimaryOwner  Boolean   @default(true)
  platformAddress String    @unique
  organizationId  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  household       household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user            user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
  @@index([householdId])
  @@index([organizationId])
  @@index([userId])
}

model twoFactor {
  id          String @id
  tenantId  String
  secret      String
  backupCodes String
  userId      String
  user        user   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
}

model user {
  id                                                    String                    @id
  tenantId                                              String
  email                                                 String                    @unique
  name                                                  String
  role                                                  Role                      @default(RESIDENT)
  isActive                                              Boolean                   @default(true)
  phone                                                 String?
  interests                                             String[]
  avatar                                                String?
  profileImage                                          String?
  books                                                 Json?                     @default("[]")
  dashboardLayout                                       Json?                     @default("null")
  isPublic                                              Boolean                   @default(true)
  showEmail                                             Boolean                   @default(true)
  showPhone                                             Boolean                   @default(true)
  createdAt                                             DateTime                  @default(now())
  updatedAt                                             DateTime
  emailVerified                                         Boolean                   @default(false)
  image                                                 String?
  twoFactorEnabled                                      Boolean?                  @default(false)
  Booking                                               Booking[]
  Content                                               Content[]
  ConversationParticipant                               ConversationParticipant[]
  Group                                                 Group[]
  GroupMembershipRequest                                GroupMembershipRequest[]
  MaintenanceRequest                                    MaintenanceRequest[]
  Message                                               Message[]
  Notification                                          Notification[]
  UserGroup                                             UserGroup[]
  account                                               account[]
  agentAccess_agentAccess_agentIdTouser                 agentAccess[]             @relation("agentAccess_agentIdTouser")
  agentAccess_agentAccess_grantedByIdTouser             agentAccess[]             @relation("agentAccess_grantedByIdTouser")
  agentProfile                                          agentProfile?
  album                                                 album[]
  communityServiceInquiry                               communityServiceInquiry[]
  communityServiceListing                               communityServiceListing[]
  communityServiceReview                                communityServiceReview[]
  invitation                                            invitation[]
  member                                                member[]
  passkey                                               passkey[]
  platformSuspension                                    platformSuspension[]
  premiumSeat                                           premiumSeat?
  profile_profile_landlordIdTouser                      profile[]                 @relation("profile_landlordIdTouser")
  profile_profile_userIdTouser                          profile[]                 @relation("profile_userIdTouser")
  propertyListing_propertyListing_assignedAgentIdTouser propertyListing[]         @relation("propertyListing_assignedAgentIdTouser")
  propertyListing_propertyListing_ownerIdTouser         propertyListing[]         @relation("propertyListing_ownerIdTouser")
  session                                               session[]
  soloSeat                                              soloSeat?
  standardSeat                                          standardSeat[]
  twoFactor                                             twoFactor[]
}

model verification {
  id         String   @id
  tenantId   String?
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@index([identifier])
}

enum AgentAccessLevel {
  VIEW_ONLY
  MANAGEMENT
  FULL_ACCESS
}

enum AgentPermission {
  VIEW_LISTING
  EDIT_LISTING
  MANAGE_OCCUPANCY
  VIEW_FINANCIALS
  CONTACT_OCCUPANTS
  MARKET_PROPERTY
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ContentCategory {
  ANNOUNCEMENT
  NEWS
  EVENT
  BLOG
  CONSERVATION
  SERVICES
  RESOURCES
  CAMPAIGN
}

enum ConversationType {
  DIRECT
  GROUP
}

enum GroupAccess {
  OPEN
  INVITE_ONLY
  APPLICATION
}

enum GroupRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum HouseholdStatus {
  ACTIVE
  ARCHIVED
}

enum InquiryStatus {
  PENDING
  RESPONDED
  ACCEPTED
