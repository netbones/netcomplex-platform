generator client {
  provider = "prisma-client-js"
}

generator drizzle {
  provider = "prisma-generator-drizzle"
  output   = "../src/db/schema"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PlatformModule {
  id             String         @id @default(cuid())
  key            String         @unique
  label          String
  minTier        Tier           @default(STANDARD)
  defaultEnabled Boolean        @default(false)
  description    String?
  createdAt      DateTime       @default(now())
  tenantModules  TenantModule[]
}

model TenantModule {
  id        String         @id @default(cuid())
  tenantId  String
  moduleKey String
  enabled   Boolean        @default(false)
  config    Json?
  enabledAt DateTime?
  module    PlatformModule @relation(fields: [moduleKey], references: [key])
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
  @@index([moduleKey])
}

model AssistSession {
  id        String    @id @default(cuid())
  tenantId  String
  staffId   String
  scope     String    @default("metadata")
  expiresAt DateTime
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  revokedBy String?
  notes     String?
  staff     user      @relation(fields: [staffId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([staffId])
  @@index([expiresAt])
  @@index([isActive])
}

model Tenant {
  id               String          @id @default(uuid())
  name             String
  slug             String          @unique
  customDomain     String?         @unique
  logoUrl          String?
  faviconUrl       String?
  primaryColor     String          @default("#4F46E5")
  accentColor      String?
  secondaryColor   String?
  fontFamily       String?
  customCss        String?
  active           Boolean         @default(true)
  subscriptionTier String          @default("basic")
  modules          Json?
  maxPages         Int             @default(5)
  pageCount        Int             @default(0)
  featureFlags     Json            @default("{}")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime?
  tier             Tier            @default(STANDARD)
  ownerId          String?
  assistSessions   AssistSession[]
  owner            user?           @relation("TenantOwner", fields: [ownerId], references: [id])
  tenantModules    TenantModule[]

  @@index([ownerId])
}

model Announcement {
  id           String         @id
  tenantId     String
  title        Json
  content      String
  author       String
  priority     String         @default("normal")
  targetFilter ResidentFilter @default(ALL)
  targetRoles  Role[]
  resourceId   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt
  expiresAt    DateTime?
  deletedAt    DateTime?
  resource     Resource?      @relation(fields: [resourceId], references: [id])

  @@index([resourceId])
}

model Booking {
  id         String        @id
  tenantId   String
  propertyId String?
  userId     String
  facility   String
  date       DateTime
  startTime  String
  endTime    String
  purpose    String?
  status     BookingStatus @default(CONFIRMED)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @default(now()) @updatedAt
  deletedAt  DateTime?
  property   Property?     @relation(fields: [propertyId], references: [id])
  user       user          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([userId])
}

model Content {
  id               String           @id
  tenantId         String
  title            Json
  content          Json
  excerpt          Json?
  image            String?
  category         ContentCategory
  tags             String[]
  authorId         String?
  groupId          String?
  published        Boolean          @default(false)
  featured         Boolean          @default(false)
  priority         String           @default("normal")
  defaultLocale    String           @default("en")
  contentType      String           @default("article")
  license          ContentLicense   @default(ALL_RIGHTS_RESERVED)
  copyrightHolder  String?
  moderationStatus ModerationStatus @default(DRAFT)
  viewCount        Int              @default(0)
  commentsEnabled  Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  publishedAt      DateTime?
  expiresAt        DateTime?
  deletedAt        DateTime?
  user             user?            @relation(fields: [authorId], references: [id])
  Group            Group?           @relation(fields: [groupId], references: [id])
  likes            ContentLike[]

  @@index([authorId])
  @@index([groupId])
}

model ContentLike {
  id        String    @id
  tenantId  String
  contentId String
  userId    String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  content   Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user      user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contentId, userId])
  @@index([contentId])
  @@index([userId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Conversation {
  id                      String                    @id
  tenantId                String
  name                    String?
  type                    ConversationType          @default(DIRECT)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now()) @updatedAt
  deletedAt               DateTime?
  ConversationParticipant ConversationParticipant[]
  Message                 Message[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ConversationParticipant {
  id                String       @id
  tenantId          String
  conversationId    String
  userId            String
  joinedAt          DateTime     @default(now())
  lastReadAt        DateTime?
  lastReadMessageId String?
  Conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              user         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Competition {
  id              String             @id @default(cuid())
  tenantId        String
  title           String
  description     String?
  rules           String?
  prizeInfo       String?
  startDate       DateTime
  endDate         DateTime
  status          CompetitionStatus  @default(DRAFT)
  entryCount      Int                @default(0)
  type            CompetitionType    @default(RAFFLE)
  winnersCount    Int                @default(1)
  maxParticipants Int?
  image           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  entries         CompetitionEntry[]

  @@index([tenantId])
  @@index([status])
}

model CompetitionEntry {
  id             String      @id @default(cuid())
  competitionId  String
  userId         String
  status         EntryStatus @default(JOINED)
  joinedAt       DateTime    @default(now())
  submissionUrl  String? // For PHOTO type — entry photo URL
  submissionText String? // For PHOTO type — optional description
  score          Float? // For SCORE type — admin-assigned score
  winnerAt       DateTime? // When marked as winner
  prize          String? // What they won
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        user        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([competitionId])
  @@index([userId])
  @@index([status])
}

model Event {
  id          String          @id
  tenantId    String
  title       String
  description String
  date        DateTime
  location    String
  organizer   String
  image       String?
  isPublic    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
  deletedAt   DateTime?
  attendees   EventAttendee[]

  @@index([tenantId])
}

model EventAttendee {
  id        String   @id
  tenantId  String
  eventId   String
  userId    String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model ExternalSurvey {
  id         String    @id
  tenantId   String
  name       String
  provider   String
  externalId String
  embedUrl   String
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  deletedAt  DateTime?
}

model Group {
  id                     String                   @id
  tenantId               String
  name                   String
  description            String?
  category               String
  image                  String?
  color                  String                   @default("#4F46E5")
  isPublic               Boolean                  @default(true)
  accessType             GroupAccess              @default(OPEN)
  residentFilter         ResidentFilter           @default(ALL)
  isActive               Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @default(now()) @updatedAt
  deletedAt              DateTime?
  ownerId                String
  Content                Content[]
  user                   user                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  GroupMembershipRequest GroupMembershipRequest[]
  GroupMember            GroupMember[]

  @@index([ownerId])
}

model GroupMembershipRequest {
  id        String           @id
  tenantId  String
  userId    String
  groupId   String
  status    MembershipStatus @default(PENDING)
  message   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt
  deletedAt DateTime?
  Group     Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      user             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId, status])
}

model MaintenanceRequest {
  id                 String           @id
  tenantId           String
  propertyId         String?
  userId             String
  category           String
  priority           Priority
  description        String
  status             RequestStatus    @default(SUBMITTED)
  images             String[]
  assignedTo         String?
  vendor             String?
  scheduledDate      DateTime?
  estimatedCost      Decimal?         @db.Decimal(10, 2)
  actualCost         Decimal?         @db.Decimal(10, 2)
  resolution         String?
  completedAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt
  ticketNumber       String
  preferredDate      DateTime?
  preferredTime      String?
  assignedTeamId     String?
  assignedProviderId String?
  property           Property?        @relation(fields: [propertyId], references: [id])
  user               user             @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTeam       MaintenanceTeam? @relation("TeamAssignments", fields: [assignedTeamId], references: [id])
  assignedProvider   ServiceProvider? @relation("ProviderAssignments", fields: [assignedProviderId], references: [id])
  histories          RequestHistory[]
  notes              RequestNote[]

  @@index([tenantId])
  @@index([assignedTeamId])
  @@index([assignedProviderId])
  @@index([propertyId])
  @@index([userId])
}

model MaintenanceTeam {
  id          String               @id @default(cuid())
  tenantId    String
  name        String
  trade       String
  contactName String?
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?
  assignments MaintenanceRequest[] @relation("TeamAssignments")

  @@index([tenantId])
}

model ServiceProvider {
  id          String               @id @default(cuid())
  tenantId    String
  companyName String
  contactName String?
  phone       String?
  email       String?
  trade       String
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?
  assignments MaintenanceRequest[] @relation("ProviderAssignments")

  @@index([tenantId])
}

model MaintenanceCategory {
  id          String    @id @default(cuid())
  tenantId    String
  value       String
  label       String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([tenantId])
}

model RequestNote {
  id         String             @id @default(cuid())
  requestId  String
  userId     String
  content    String
  isInternal Boolean            @default(false)
  createdAt  DateTime           @default(now())
  request    MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user       user               @relation(fields: [userId], references: [id])

  @@index([requestId])
}

model RequestHistory {
  id        String             @id @default(cuid())
  requestId String
  userId    String
  field     String
  oldValue  String?
  newValue  String?
  comment   String?
  createdAt DateTime           @default(now())
  request   MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      user               @relation(fields: [userId], references: [id])

  @@index([requestId])
  @@index([userId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Message {
  id             String       @id
  tenantId       String
  conversationId String
  senderId       String
  content        String
  type           MessageType  @default(TEXT)
  createdAt      DateTime     @default(now())
  expiresAt      DateTime?
  deletedAt      DateTime?
  mediaUrl       String?
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           user         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([expiresAt])
  @@index([senderId])
}

model Notification {
  id        String    @id
  tenantId  String
  userId    String
  title     String
  message   String
  type      String
  link      String?
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  user      user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}

model Question {
  id        String         @id
  tenantId  String
  surveyId  String
  sectionId String?
  text      String
  type      QuestionType
  options   String[]
  required  Boolean        @default(false)
  order     Int            @default(0)
  config    Json?          @default("{}")
  deletedAt DateTime?
  Survey    Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  Section   SurveySection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([surveyId])
  @@index([sectionId])
}

model Response {
  id        String    @id
  tenantId  String
  surveyId  String
  userId    String?
  answers   Json
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  Survey    Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
}

model Setting {
  id            String   @id
  tenantId      String
  key           String
  value         String
  schemaVersion Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([tenantId, key])
}

model SurveySection {
  id          String     @id
  tenantId    String
  surveyId    String
  title       String?
  description String?
  image       String?
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  deletedAt   DateTime?
  Survey      Survey     @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  Question    Question[]

  @@index([surveyId])
}

model Survey {
  id          String          @id
  tenantId    String
  title       String
  description String?
  type        SurveyType      @default(INTERNAL)
  status      SurveyStatus    @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  config      Json?           @default("{}")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
  deletedAt   DateTime?
  Question    Question[]
  Response    Response[]
  Section     SurveySection[]
}

model GroupMember {
  id        String    @id
  tenantId  String
  userId    String
  groupId   String
  role      GroupRole @default(MEMBER)
  joinedAt  DateTime  @default(now())
  deletedAt DateTime?
  Group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([userId])
}

model account {
  id                    String    @id
  tenantId              String?
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AgentAccess {
  id                                 String            @id
  tenantId                           String
  agentId                            String
  propertyId                         String
  grantedById                        String
  accessLevel                        AgentAccessLevel  @default(MANAGEMENT)
  permissions                        AgentPermission[]
  startedAt                          DateTime          @default(now())
  expiresAt                          DateTime
  isActive                           Boolean           @default(true)
  commissionRate                     Decimal?          @db.Decimal(5, 2)
  contractTerms                      String?
  organizationId                     String?
  createdAt                          DateTime          @default(now())
  updatedAt                          DateTime          @default(now()) @updatedAt
  deletedAt                          DateTime?
  user_agentAccess_agentIdTouser     user              @relation("agentAccess_agentIdTouser", fields: [agentId], references: [id])
  user_agentAccess_grantedByIdTouser user              @relation("agentAccess_grantedByIdTouser", fields: [grantedById], references: [id])
  property                           Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([expiresAt])
  @@index([propertyId])
  @@index([organizationId])
  @@index([grantedById])
}

model AgentProfile {
  id               String    @id
  tenantId         String
  agentId          String    @unique
  agencyName       String?
  licenseNumber    String?
  experienceYears  Int       @default(0)
  specializations  String[]
  serviceAreas     String[]
  totalListings    Int       @default(0)
  activeListings   Int       @default(0)
  salesCompleted   Int       @default(0)
  avgSalePrice     Decimal?  @db.Decimal(12, 2)
  rating           Float     @default(0)
  reviewCount      Int       @default(0)
  commissionRate   Decimal?  @db.Decimal(5, 2)
  responseTime     Int       @default(24)
  isVerified       Boolean   @default(false)
  verificationDate DateTime?
  organizationId   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  deletedAt        DateTime?
  user             user      @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([isVerified])
  @@index([organizationId])
  @@index([rating])
}

model Album {
  id          String    @id
  tenantId    String
  userId      String
  title       String
  description String?
  isPublic    Boolean   @default(false)
  mediaIds    String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?
  user        user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isPublic])
  @@index([userId])
}

model CommunityServiceInquiry {
  id                      String                  @id
  tenantId                String
  listingId               String
  inquirerId              String
  serviceType             String?
  preferredDate           DateTime?
  preferredTime           String?
  location                String?
  description             String
  contactMethod           String                  @default("PLATFORM_MESSAGE")
  status                  InquiryStatus           @default(PENDING)
  providerResponse        String?
  respondedAt             DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @default(now()) @updatedAt
  deletedAt               DateTime?
  user                    user                    @relation(fields: [inquirerId], references: [id])
  communityServiceListing CommunityServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([inquirerId])
  @@index([listingId])
  @@index([status])
}

model CommunityServiceListing {
  id                      String                    @id
  tenantId                String
  providerId              String
  providerType            ProviderType              @default(COMMUNITY)
  title                   Json
  description             Json?
  category                String
  subcategory             String?
  priceType               PriceType
  price                   Decimal?                  @db.Decimal(10, 2)
  currency                String                    @default("ZAR")
  serviceAreas            String[]
  availability            Json?
  licenseNumber           String?
  insuranceExpiry         DateTime?
  verified                Boolean                   @default(false)
  verificationDate        DateTime?
  responseTime            Int                       @default(24)
  contactMethods          String[]
  images                  String[]
  portfolio               String[]
  status                  ListingStatus             @default(DRAFT)
  isPublished             Boolean                   @default(false)
  isFeatured              Boolean                   @default(false)
  moderatedBy             String?
  moderatedAt             DateTime?
  moderationNotes         String?
  rating                  Float                     @default(0)
  reviewCount             Int                       @default(0)
  termsAndConditions      String?
  cancellationPolicy      String?
  organizationId          String?
  slug                    String?
  locale                  String                    @default("en")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now()) @updatedAt
  deletedAt               DateTime?
  communityServiceInquiry CommunityServiceInquiry[]
  user                    user                      @relation(fields: [providerId], references: [id])
  communityServiceReview  CommunityServiceReview[]

  @@index([category])
  @@index([isPublished])
  @@index([organizationId])
  @@index([providerId])
  @@index([status])
  @@index([verified])
}

model CommunityServiceReview {
  id                      String                  @id
  tenantId                String
  listingId               String
  reviewerId              String
  rating                  Int
  title                   String?
  comment                 String?
  serviceDate             DateTime?
  responseQuality         Int?
  isPublished             Boolean                 @default(true)
  moderatedBy             String?
  moderatedAt             DateTime?
  createdAt               DateTime                @default(now())
  deletedAt               DateTime?
  communityServiceListing CommunityServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user                    user                    @relation(fields: [reviewerId], references: [id])

  @@index([listingId])
  @@index([rating])
  @@index([reviewerId])
}

model Property {
  id                  String                @id @default(cuid())
  tenantId            String
  platformAddress     String
  street              String
  unit                String
  ownerId             String?
  homeImage           String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  deletedAt           DateTime?
  Booking             Booking[]
  households          Household[]
  MaintenanceRequest  MaintenanceRequest[]
  owner               user?                 @relation("PropertyOwner", fields: [ownerId], references: [id])
  agentAccess         AgentAccess[]
  propertyListing     PropertyListing[]
  soloSeat            SoloSeat[]
  standardSeat        StandardSeat[]
  PropertyPremiumSeat PropertyPremiumSeat[]

  @@index([ownerId])
  @@index([platformAddress])
}

model Household {
  id             String          @id @default(cuid())
  tenantId       String
  propertyId     String
  organizationId String?
  occupancyType  OccupancyType   @default(OWNER_OCCUPIED)
  status         HouseholdStatus @default(ACTIVE)
  moveInDate     DateTime?
  moveOutDate    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  profiles       Profile[]

  @@index([propertyId])
  @@index([organizationId])
}

model Invitation {
  id             String           @id
  tenantId       String
  email          String           @unique
  name           String
  street         String?
  unit           String?
  residencyType  ResidencyType    @default(OWNER)
  role           Role             @default(RESIDENT)
  token          String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @default(now())
  createdAt      DateTime         @default(now())
  deletedAt      DateTime?
  organizationId String
  inviterId      String
  user           user             @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId])
  @@index([inviterId])
}

model Member {
  id             String       @id
  tenantId       String
  organizationId String
  userId         String
  role           String       @default("member")
  createdAt      DateTime
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           user         @relation(fields: [userId], references: [id], onDelete: Cascade)

