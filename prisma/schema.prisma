model ProviderVerification {
  id                    String                   @id @default(cuid())
  providerId            String                   @unique
  tenantId              String
  status                ProviderVerificationStatus @default(PENDING)
  notes                 String?
  startDate             DateTime                 @default(now())
  endDate               DateTime?
  verificationThreshold Int                      @default(300) @map("verification_threshold")
  probationThreshold    Int                      @default(0) @map("probation_threshold")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([providerId])
  @@map("provider_verifications")
}

model ProviderLegalAgreement {
  id            String   @id @default(cuid())
  providerId    String   @map("provider_id")
  tenantId      String   @map("tenant_id")
  agreementType String   @map("agreement_type") // 'TOS', 'PRIVACY', 'CODE_OF_CONDUCT'
  version       String
  acceptedAt    DateTime @default(now()) @map("accepted_at")
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([providerId])
  @@map("provider_legal_agreements")
}

model ProviderCredit {
  id                  String    @id @default(cuid())
  providerId          String    @unique @map("provider_id")
  tenantId            String    @map("tenant_id")
  totalCredits        Int       @default(0) @map("total_credits")
  responseTimeScore   Int?      @map("response_time_score")
  qualityScore        Int?      @map("quality_score")
  reviewScore         Int?      @map("review_score")
  complianceScore     Int?      @map("compliance_score")
  engagementScore     Int?      @map("engagement_score")
  lastCalculatedAt    DateTime? @map("last_calculated_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("provider_credits")
}

model ProviderMerit {
  id          String            @id @default(cuid())
  providerId  String            @map("provider_id")
  tenantId    String            @map("tenant_id")
  meritType   ProviderMeritType @map("merit_type")
