// ═══════════════════════════════════════════════════════════════
// PROVIDER BILLING (Phase 46)
// ═══════════════════════════════════════════════════════════════

model SubscriptionTier {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  name              String
  description       String?
  price             Decimal  @db.Decimal(10, 2)
  currency          String   @default("ZAR")
  maxListings       Int?     @map("max_listings")
  features          Json?
  platformFeePercent Decimal @default(8.00) @map("platform_fee_percent") @db.Decimal(5, 2)
  verificationRequired Boolean @default(false) @map("verification_required")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("subscription_tiers")
}

model ProviderSubscription {
  id             String   @id @default(cuid())
  providerId     String   @map("provider_id")
  tenantId       String   @map("tenant_id")
  tierId         String   @map("tier_id")
  status         SubscriptionStatus @default(ACTIVE)
  startDate      DateTime @map("start_date")
  endDate        DateTime? @map("end_date")
  nextBillingDate DateTime? @map("next_billing_date")
  price          Decimal  @db.Decimal(10, 2)
  currency       String   @default("ZAR")
  paymentGateway PaymentGateway? @map("payment_gateway")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([providerId])
  @@map("provider_subscriptions")
}

model PaymentTransaction {
  id            String   @id @default(cuid())
  providerId    String   @map("provider_id")
  tenantId      String   @map("tenant_id")
  subscriptionId String  @map("subscription_id")
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("ZAR")
  platformFee   Decimal  @map("platform_fee") @db.Decimal(10, 2)
  processorFee  Decimal  @map("processor_fee") @db.Decimal(10, 2)
  netAmount     Decimal  @map("net_amount") @db.Decimal(10, 2)
  status        TransactionStatus @default(PENDING)
  gateway       PaymentGateway
  externalRef   String?  @map("external_ref进项")
  invoiceUrl    String?  @map("invoice_url")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([providerId])
  @@index([subscriptionId])
  @@map("payment_transactions")
}

model RevenueRecord {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  providerId    String   @map("provider_id")
  transactionId String  @map("transaction_id")
  grossAmount   Decimal  @map("gross_amount") @db.Decimal(10, 2)
  platformFee   Decimal  @map("platform_fee") @db.Decimal(10, 2)
  processorFee  Decimal  @map("processor_fee") @db.Decimal(10, 2)
  netAmount     Decimal  @map("net_amount") @db.Decimal(10, 2)
  currency      String   @default("ZAR")
  period        String
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([providerId])
  @@map("revenue_records")
}

// ═══════════════════════════════════════════════════════════════
// PROVIDER BILLING ENUMS
// ═══════════════════════════════════════════════════════════════

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PENDING
}

enum PaymentGateway {
  PAYSTACK
  PAYPAL
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}
