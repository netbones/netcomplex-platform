
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  role         Role         @default(RESIDENT)
  isActive     Boolean      @default(true)
  phone        String?
  interests    String[]
  avatar       String?
  profileImage String?
  books        Json?        @default("[]")
  dashboardLayout Json?      @default("null")
  isPublic     Boolean      @default(true)
  showEmail    Boolean      @default(true)
  showPhone    Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  requests         MaintenanceRequest[]
  bookings         Booking[]
  notifications    Notification[]
  conversationParticipants ConversationParticipant[]
  messages         Message[]
  groupMemberships UserGroup[]
  ownedGroups      Group[]
  contents         Content[]
  emailVerified    Boolean              @default(false)
  image            String?
  twoFactorEnabled Boolean?             @default(false)
  sessions         Session[]
  accounts         Account[]
  twofactors       TwoFactor[]
  members          Member[]
  invitations      Invitation[]
  passkeys         Passkey[]
  suspensions      PlatformSuspension[]
  membershipRequests GroupMembershipRequest[]
  albums             Album[]

  // Identity model relations
  standardSeats   StandardSeat[]
  soloSeat         SoloSeat?
  premiumSeat      PremiumSeat?
  profiles         Profile[]
  agentAccesses   AgentAccess[]     @relation("AgentAccessAgent")  // If user is an agent
  grantedAccesses  AgentAccess[]     @relation("AgentAccessGrantedBy")  // Access grants by this user (as owner)
  agentProfile     AgentProfile?     // If user is a registered agent
  ownedListings    PropertyListing[] // Properties listed by this user
  assignedListings PropertyListing[] @relation("PropertyListingAgent") // Properties assigned to this agent

  // Community Services Marketplace relations
  serviceListings  CommunityServiceListing[] // Service listings by this provider
  serviceReviews   CommunityServiceReview[]  // Reviews written by this user
  serviceInquiries CommunityServiceInquiry[] // Service inquiries by this user

  @@map("user")
}

enum Role {
  RESIDENT // Default user
  GROUP_ADMIN // Manages only their own group
  COMMITTEE // Committee member
  BOARD // HOA Board member
  ADMIN // SuperAdmin - full platform access
  AGENT // Property agent/letting agent with delegated access
}

enum ResidentType {
  OWNER
  RENTER
  SUSPENDED
}

model PlatformSuspension {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  suspensionType SuspensionType
  reason      String
  description String?
  startDate   DateTime          @default(now())
  endDate     DateTime?
  isPermanent Boolean           @default(false)
  isActive    Boolean           @default(true)
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
  @@index([isActive])
  @@map("platformSuspension")
}

enum SuspensionType {
  NON_PAYMENT // Non-payment of HOA fees
  VIOLATION   // Community rule violation
  DISRUPTION  // Disruptive behavior
  PROPERTY    // Property maintenance violations
  BEHAVIOR    // Unacceptable behavior
  OTHER       // Other reasons
}

model MaintenanceRequest {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String
  priority    Priority
  description String
  status      RequestStatus @default(SUBMITTED)
  images      String[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum RequestStatus {
  SUBMITTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GroupAccess {
  OPEN        // Anyone can join
  INVITE_ONLY // Requires invitation from group admin
  APPLICATION // Requires application approval
}

enum ResidentFilter {
  ALL         // All residents can join
  OWNERS_ONLY // Homeowners only
  RENTERS_ONLY // Renters only
}

model Booking {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility  String
  date      DateTime
  startTime String
  endTime   String
  purpose   String?
  status    BookingStatus @default(CONFIRMED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  date        DateTime
  location    String
  organizer   String
  image       String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Content {
  id          String          @id @default(cuid())
  title       String
  content     String          @db.Text
  excerpt     String?
  image       String?
  category    ContentCategory
  tags        String[]
  authorId    String?
  author      User?           @relation(fields: [authorId], references: [id])
  groupId     String?
  group       Group?          @relation(fields: [groupId], references: [id])
  published   Boolean         @default(false)
  featured    Boolean         @default(false)
  priority    String          @default("normal")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  publishedAt DateTime?
  expiresAt   DateTime?
}

enum ContentCategory {
  ANNOUNCEMENT
  NEWS
  EVENT
  BLOG
  CONSERVATION
  SERVICES
  RESOURCES
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  content   String
  author    String
  priority  String    @default("normal")
  createdAt DateTime  @default(now())
  expiresAt DateTime?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Conversation {
  id           String                  @id @default(cuid())
  name         String?
  type         ConversationType        @default(DIRECT)
  participants ConversationParticipant[]
  messages     Message[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?    // When user last read this conversation
  lastReadMessageId String?   // ID of last message user read

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

enum ConversationType {
  DIRECT
  GROUP
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  type           MessageType  @default(TEXT)
  createdAt      DateTime     @default(now())
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

model Survey {
  id          String       @id @default(cuid())
  title       String
  description String?
  type        SurveyType   @default(INTERNAL)
  status      SurveyStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  questions   Question[]
  responses   Response[]
}

enum SurveyType {
  INTERNAL
  EXTERNAL
}

enum SurveyStatus {
  DRAFT
  ACTIVE
  CLOSED
}

model Question {
  id        String       @id @default(cuid())
  surveyId  String
  survey    Survey      @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  text      String
  type      QuestionType
  options   String[]
  required Boolean      @default(false)
  order     Int          @default(0)
}

model Response {
  id        String   @id @default(cuid())
  surveyId  String
  survey    Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId    String?
  answers   Json
  createdAt DateTime @default(now())
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TEXT
  RATING
  YES_NO
}

model ExternalSurvey {
  id         String   @id @default(cuid())
  name       String
  provider   String
  externalId String
  embedUrl   String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Group {
  id          String       @id @default(cuid())
  name        String
  description String?
  category    String
  image       String?
  color       String      @default("#4F46E5")
  isPublic    Boolean     @default(true)
  accessType  GroupAccess @default(OPEN)
  residentFilter ResidentFilter @default(ALL)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  ownerId     String
  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members    UserGroup[]
  contents   Content[]
  membershipRequests GroupMembershipRequest[]
}

enum GroupRole {
  MEMBER
  MODERATOR
  ADMIN
}

model UserGroup {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId  String
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@unique([userId, groupId])
}

model GroupMembershipRequest {
  id          String            @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId     String
  group       Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status      MembershipStatus @default(PENDING)
  message     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, groupId])
  @@index([groupId, status])
}

model Invitation {
  id             String           @id @default(cuid())
  email          String           @unique
  name           String
  street         String?
  unit           String?
  residentType   ResidentType     @default(OWNER)
  role           Role             @default(RESIDENT)
  token          String           @unique @default(cuid())
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @default(now())
  createdAt      DateTime         @default(now())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviterId      String
  user           User             @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  impersonatedBy       String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id          String @id
  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

// ============ IDENTITY MODEL MODELS ============

// Household - represents a property unit (Standard Seat container)
model Household {
  id              String    @id @default(cuid())
  
  // Multi-tenancy
  organizationId  String?
  
  // Property reference
  street          String
  unit            String    // Unit number, e.g., "042"
  
  // Platform address (e.g., unit042@soralia.org)
  platformAddress String    @unique
  
  // HomeImage (property photo)
  homeImage       String?
  
  // Status
  status          HouseholdStatus @default(ACTIVE)
  moveInDate      DateTime?
  moveOutDate     DateTime?
  
  // Relationships
  standardSeats   StandardSeat[]
  profiles        Profile[]
  soloSeats       SoloSeat[]
  premiumSeats    PremiumSeat[] @relation("PremiumSeatPortfolio") // Premium portfolio management
  propertyListings PropertyListing[] // Property listings for this household
  agentAccesses   AgentAccess[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([street, unit])
  @@index([platformAddress])
  @@index([organizationId])
  @@map("household")
}

enum HouseholdStatus {
  ACTIVE
  ARCHIVED
}

// Standard Seat - property owner identity (one per owner per household)
model StandardSeat {
  id              String    @id @default(cuid())
  
  // User (the property owner)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Household (the property they own)
  householdId     String
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  
  // Role in household
  isPrimaryOwner  Boolean   @default(true)
  
  // Platform address (e.g., jack.unit042@soralia.org)
  platformAddress String    @unique
  
  // Multi-tenancy
  organizationId  String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, householdId])
  @@index([userId])
  @@index([householdId])
  @@index([organizationId])
  @@map("standardSeat")
}

// Profile - sub-identity under household (occupants, family, minors)
model Profile {
  id              String    @id @default(cuid())
  
  // Household relationship
  householdId     String
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  
  // Profile identity
  displayName     String
  profileAddress  String    @unique // e.g., john.unit042@soralia.org
  
  // User link (for upgrade to Premium - optional, null until upgrade)
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])
  
  // Profile details
  avatar          String?
  isPublic        Boolean   @default(true)
  showEmail       Boolean   @default(true)
  showPhone       Boolean   @default(true)
  
  // Tenure tracking (for upgrade eligibility)
  occupantSince   DateTime  @default(now())
  occupantType    OccupantType @default(OCCUPANT)
  
  // Lease info for agents
  leaseStartDate  DateTime?
  leaseEndDate    DateTime?
  
  status          ProfileStatus @default(ACTIVE)
  
  // Multi-tenancy
  organizationId  String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([householdId, profileAddress])
  @@index([householdId])
  @@index([userId])
  @@index([organizationId])
  @@map("profile")
}

enum OccupantType {
  OCCUPANT   // Adult resident
  MINOR      // Child/minor under adult supervision
  FAMILY     // Extended family member
}

enum AgentAccessLevel {
  VIEW_ONLY     // Can view property details
  MANAGEMENT    // Can manage occupancy and basic updates
  FULL_ACCESS   // Can make significant changes and list property
}

enum AgentPermission {
  VIEW_LISTING
  EDIT_LISTING
  MANAGE_OCCUPANCY
  VIEW_FINANCIALS
  CONTACT_OCCUPANTS
  MARKET_PROPERTY
}

enum ListingType {
  SALE
  RENT
  LEASE
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PENDING
  SOLD
  RENTED
  WITHDRAWN
}

enum ProfileStatus {
  ACTIVE       // Currently living there
  UPGRADED     // Upgraded to Solo Seat
  REMOVED      // Moved out (generic)
  EVICTED      // Removed due to eviction
  LEASE_ENDED  // Lease term completed
}

// Solo Seat - independent identity (resident or member)
model SoloSeat {
  id              String    @id @default(cuid())
  
  // User relationship
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  
  // Platform address (e.g., john@soralia.org)
  platformAddress String    @unique
  
  // Property reference (if property owner)
  householdId     String?
  household       Household? @relation(fields: [householdId], references: [id])
  
  // Premium type
  seatType        SoloSeatType

  // Complimentary (for board/committee)
  isComplimentary Boolean  @default(false)
  
  // For upgraded occupants - link back to original household
  linkedFromProfileId String?
  
  // Multi-tenancy
  organizationId  String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([householdId])
  @@index([organizationId])
  @@map("soloSeat")
}

enum SoloSeatType {
  RESIDENT   // Lives in community
  MEMBER     // HOA member, doesn't live here
}

// Premium Seat - Multi-property investment portfolio consolidation
model PremiumSeat {
  id              String    @id @default(cuid())

  // User relationship (property investor)
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // PORTFOLIO MANAGEMENT - Links multiple households for unified management
  linkedHouseholds Household[] @relation("PremiumSeatPortfolio")

  // Premium features
  isActive        Boolean   @default(true)
  portfolioName   String?   // Optional custom portfolio name

  // Pricing and billing
  subscriptionTier String   @default("basic") // basic, pro, enterprise
  maxProperties   Int       @default(5)      // Property limit based on tier

  // Platform address (e.g., investor@soralia.org)
  platformAddress String    @unique

  // Multi-tenancy
  organizationId  String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@map("premiumSeat")
}

// Agent Access - property agent authorization
model AgentAccess {
  id              String    @id @default(cuid())

  // Agent (user with AGENT role)
  agentId         String
  agent           User      @relation("AgentAccessAgent", fields: [agentId], references: [id])

  // Household being managed
  householdId     String
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  // Who granted access
  grantedById     String
  grantedBy       User      @relation("AgentAccessGrantedBy", fields: [grantedById], references: [id])

  // Access level and permissions
  accessLevel     AgentAccessLevel @default(MANAGEMENT)
  permissions     AgentPermission[]

  // Access period
  startedAt       DateTime  @default(now())
  expiresAt       DateTime

  // Status
  isActive        Boolean   @default(true)

  // Commission and business terms
  commissionRate  Float?    // Percentage for sales/rentals
  contractTerms   String?   // Legal terms and conditions

  // Multi-tenancy
  organizationId  String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([agentId])
  @@index([householdId])
  @@index([organizationId])
  @@index([expiresAt])
  @@map("agentAccess")
}

// Property Listings - Premium Seat marketplace feature
model PropertyListing {
  id              String    @id @default(cuid())

  // Property being listed
  householdId     String
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  // Listing owner (Premium Seat holder)
  ownerId         String
  owner           User      @relation(fields: [ownerId], references: [id])

  // Listing details
  listingType     ListingType  // SALE, RENT, LEASE
  title           String
  description     String?
  price           Float?
  currency        String      @default("ZAR")

  // Property details
  bedrooms        Int?
  bathrooms       Int?
  parkingSpaces   Int?
  gardenSize      Float?      // Square meters
  petFriendly     Boolean     @default(false)

  // Status and visibility
  status          ListingStatus @default(DRAFT)
  isPublished     Boolean       @default(false)
  isFeatured      Boolean       @default(false)

  // Agent management (optional)
  assignedAgentId String?
  assignedAgent   User?         @relation("PropertyListingAgent", fields: [assignedAgentId], references: [id])

  // Marketing
  marketingBudget Float?        // Monthly marketing spend
  featuredUntil   DateTime?

  // Multi-tenancy
  organizationId  String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([householdId])
  @@index([ownerId])
  @@index([listingType])
  @@index([status])
  @@index([isPublished])
  @@index([assignedAgentId])
  @@index([organizationId])
  @@map("propertyListing")
}

// Agent Profiles - Enhanced agent marketplace
model AgentProfile {
  id              String    @id @default(cuid())

  // Agent user
  agentId         String    @unique
  agent           User      @relation(fields: [agentId], references: [id], onDelete: Cascade)

  // Business details
  agencyName      String?
  licenseNumber   String?
  experienceYears Int       @default(0)

  // Specializations
  specializations String[]  // SALE, RENT, COMMERCIAL, RESIDENTIAL, etc.

  // Service areas
  serviceAreas    String[]  // Neighborhood names

  // Performance metrics
  totalListings   Int       @default(0)
  activeListings  Int       @default(0)
  salesCompleted  Int       @default(0)
  avgSalePrice    Float?

  // Ratings and reviews
  rating          Float     @default(0) // 1-5 stars
  reviewCount     Int       @default(0)

  // Business settings
  commissionRate  Float     @default(5.0) // Default commission percentage
  responseTime    Int       @default(24)  // Hours to respond

  // Verification status
  isVerified      Boolean   @default(false)
  verificationDate DateTime?

  // Multi-tenancy
  organizationId  String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([agentId])
  @@index([isVerified])
  @@index([rating])
  @@index([organizationId])
  @@map("agentProfile")
}

// User Albums for Media Gallery organization
model Album {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isPublic    Boolean  @default(false)
  mediaIds    String[] // Array of media keys from storage
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([isPublic])
  @@map("album")
}

// Community Services Marketplace
model CommunityServiceListing {
  id              String    @id @default(cuid())

  // Provider information
  providerId      String
  provider        User      @relation(fields: [providerId], references: [id])

  // Service details
  title           String
  description     String?
  category        ServiceCategory
  subcategory     String?

  // Pricing and availability
  priceType       PriceType // FIXED, HOURLY, QUOTE, FREE
  price           Float?    // Base price, null for QUOTE or FREE
  currency        String    @default("ZAR")

  // Service area and availability
  serviceAreas    String[]  // Neighborhood names or "All Areas"
  availability    Json?     // Hours, days available

  // Provider credentials and verification
  licenseNumber   String?
  insuranceExpiry DateTime?
  verified        Boolean   @default(false)
  verificationDate DateTime?

  // Contact and response
  responseTime    Int       @default(24) // Hours to respond
  contactMethods  String[]  // EMAIL, PHONE, PLATFORM_MESSAGE

  // Media
  images          String[]  // URLs to service photos
  portfolio       String[]  // Additional portfolio images

  // Status and moderation
  status          ListingStatus @default(DRAFT)
  isPublished     Boolean       @default(false)
  isFeatured      Boolean       @default(false)
  moderatedBy     String?       // Admin user ID who last moderated
  moderatedAt     DateTime?
  moderationNotes String?

  // Ratings and reviews
  rating          Float     @default(0)
  reviewCount     Int       @default(0)

  // Business terms
  termsAndConditions String?
  cancellationPolicy String?

  // Multi-tenancy
  organizationId  String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  reviews   CommunityServiceReview[]
  inquiries CommunityServiceInquiry[]

  @@index([providerId])
  @@index([category])
  @@index([status])
  @@index([isPublished])
  @@index([verified])
  @@index([organizationId])
  @@map("communityServiceListing")
}

// Community Service Reviews
model CommunityServiceReview {
  id              String    @id @default(cuid())

  // Review relationship
  listingId       String
  listing         CommunityServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // Reviewer
  reviewerId      String
  reviewer        User      @relation(fields: [reviewerId], references: [id])

  // Review content
  rating          Int       // 1-5 stars
  title           String?
  comment         String?

  // Service details
  serviceDate     DateTime?
  responseQuality Int?      // 1-5 scale

  // Moderation
  isPublished     Boolean   @default(true)
  moderatedBy     String?
  moderatedAt     DateTime?

  createdAt       DateTime  @default(now())

  @@index([listingId])
  @@index([reviewerId])
  @@index([rating])
  @@map("communityServiceReview")
}

// Service Inquiry/Booking
model CommunityServiceInquiry {
  id              String    @id @default(cuid())

  // Inquiry relationship
  listingId       String
  listing         CommunityServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // Parties
  inquirerId      String
  inquirer        User      @relation(fields: [inquirerId], references: [id])

  // Inquiry details
  serviceType     String?   // Specific service requested
  preferredDate   DateTime?
  preferredTime   String?   // Time preference
  location        String?   // Service location details
  description     String    // Service requirements

  // Contact preferences
  contactMethod   String    @default("PLATFORM_MESSAGE")

  // Status
  status          InquiryStatus @default(PENDING)
  providerResponse String?
  respondedAt     DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([listingId])
  @@index([inquirerId])
  @@index([status])
  @@map("communityServiceInquiry")
}

// Enums for Community Services
enum ServiceCategory {
  GARDENING
  MAINTENANCE
  PLUMBING
  ELECTRICAL
  CLEANING
  SECURITY
  PEST_CONTROL
  APPLIANCE_REPAIR
  OTHER
}

enum PriceType {
  FIXED
  HOURLY
  QUOTE
  FREE
}

enum InquiryStatus {
  PENDING
  RESPONDED
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}
