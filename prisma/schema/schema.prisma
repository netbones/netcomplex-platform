model MeetingProxy {
  id                String            @id @default(uuid())
  tenantId          String
  Tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  meetingId         String
  Meeting           Event             @relation("EventProxy", fields: [meetingId], references: [id])
  ownerUserId       String
  ownerHouseholdId  String
  proxyUserId       String?
  proxyName         String?
  proxyEmail        String?
  proxyPhone        String?
  formDocumentId    String?
  ownerSignedAt     DateTime?
  proxySignedAt     DateTime?
  approvedBy        String?
  approvedAt        DateTime?
  status            ProxyStatus       @default(Draft)
  notes             String?
  signatureProvider SignatureProvider @default(INTERNAL)
  signatureEvidence Json              @default("{}")
  credentialId      String?
  credential        Credential?       @relation("MeetingProxyToCredential", fields: [credentialId], references: [id])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  referenceCode     String?           @unique
  owner             user              @relation("MeetingProxyOwner", fields: [ownerUserId], references: [id])
  proxy             user?             @relation("MeetingProxyProxy", fields: [proxyUserId], references: [id])
  approver          user?             @relation("MeetingProxyApprover", fields: [approvedBy], references: [id])

  @@index([tenantId])
  @@index([meetingId])
  @@index([ownerUserId])
  @@index([ownerHouseholdId])
  @@index([proxyUserId])
  @@index([status])
  @@index([meetingId, status])
  @@map("meeting_proxies")
}
