generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

generator drizzle {
  provider = "prisma-generator-drizzle"
  output   = "../../src/db/schema"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model account {
  id                    String    @id
  tenantId              String?
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model verification {
  id         String   @id
  tenantId   String?
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

model passkey {
  id           String    @id
  tenantId     String
  name         String?
  publicKey    String
  userId       String
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?
  user         user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([credentialID])
  @@index([userId])
}

model session {
  id                   String   @id
  tenantId             String?
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  impersonatedBy       String?
  user                 user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model twoFactor {
  id          String @id
  tenantId    String
  secret      String
  backupCodes String
  userId      String
  user        user   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
}

model user {
  id                                                    String                    @id
  tenantId                                              String?
  email                                                 String                    @unique
  name                                                  String
  role                                                  Role                      @default(USER)
  isActive                                              Boolean                   @default(false)
  phone                                                 String?
  interests                                             String[]
  avatar                                                String?
  profileImage                                          String?
  books                                                 Json?                     @default("[]")
  dashboardLayout                                       Json?                     @default("null")
  isPublic                                              Boolean                   @default(true)
  showEmail                                             Boolean                   @default(true)
  showPhone                                             Boolean                   @default(true)
  profileSlug                                           String?
  createdAt                                             DateTime                  @default(now())
  updatedAt                                             DateTime                  @default(now()) @updatedAt
  emailVerified                                         Boolean                   @default(false)
  image                                                 String?
  twoFactorEnabled                                      Boolean?                  @default(false)
  isPlatformAdmin                                       Boolean                   @default(false)
  notificationPreferences                               Json?                     @default("{\"info\": {\"email\": true, \"inApp\": true}, \"error\": {\"email\": true, \"inApp\": true}, \"success\": {\"email\": true, \"inApp\": true}, \"warning\": {\"email\": true, \"inApp\": true}}")
  banExpires                                            DateTime?
  banReason                                             String?
  banned                                                Boolean                   @default(false)
  profileData                                           Json?                     @default("{}")
  agentAccess_agentAccess_agentIdTouser                 AgentAccess[]             @relation("agentAccess_agentIdTouser")
  agentAccess_agentAccess_grantedByIdTouser             AgentAccess[]             @relation("agentAccess_grantedByIdTouser")
  agentProfile                                          AgentProfile?
  agentTokensAsAgent                                    AgentToken[]              @relation("agentToken_agentIdTouser")
  agentTokensIssued                                     AgentToken[]              @relation("agentToken_issuedByIdTouser")
  agentReviewsAsReviewer                                AgentReview[]             @relation("AgentReview_reviewerToUser")
  album                                                 Album[]
  assistSessions                                        AssistSession[]
  Booking                                               Booking[]
  communityMeritsCreatedBy                              CommunityMerit[]          @relation("CommunityMeritCreatedBy")
  communityMeritsResolvedBy                             CommunityMerit[]          @relation("CommunityMeritResolvedBy")
  communityMeritsSubject                                CommunityMerit[]          @relation("CommunityMeritSubject")
  communityServiceInquiry                               CommunityServiceInquiry[]
  communityServiceListing                               CommunityServiceListing[]
  communityServiceReview                                CommunityServiceReview[]
  CompetitionEntry                                      CompetitionEntry[]
  Content                                               Content[]
  ContentLike                                           ContentLike[]
  ContentVersion                                        ContentVersion[]
  comments                                              Comment[]
  commentVotes                                          CommentVote[]
  commentReports                                        CommentReport[]
  ContentAuditLog                                       ContentAuditLog[]
  ConversationParticipant                               ConversationParticipant[]
  dWallet                                               DWallet?
  delegationActionsAsActor                              DelegationAction[]
  disputeCases_moderator                                DisputeCase[]             @relation("DisputeModerator")
  disputeCases_closedBy                                 DisputeCase[]             @relation("DisputeClosedBy")
  disputeCases_complainant                              DisputeCase[]             @relation("DisputeComplainant")
  disputeCases_respondent                               DisputeCase[]             @relation("DisputeRespondent")
  disputeEvent_actor                                    DisputeEvent[]            @relation("DisputeEventActor")
  disputeEvidence_uploader                              DisputeEvidence[]         @relation("DisputeEvidenceUploader")
  disputeMessage_sender                                 DisputeMessage[]          @relation("DisputeMessageSender")
  disputeNotification_user                              DisputeNotification[]     @relation("DisputeNotificationUser")
  EventAttendee                                         EventAttendee[]
  EventCreatedBy                                        Event[]                  @relation("EventCreatedBy")
  Group                                                 Group[]
  GroupMember                                           GroupMember[]
  GroupMembershipRequest                                GroupMembershipRequest[]
  MaintenanceTeamMember                                 MaintenanceTeamMember[]
  InternalMaintenanceNote                               InternalMaintenanceNote[]
  invitation                                            Invitation[]
  maintenanceRequestsAsLandlord                         MaintenanceRequest[]      @relation("MaintenanceRequest_landlord")
  MaintenanceRequest                                    MaintenanceRequest[]
  mediaUploads                                          MediaUpload[]
  member                                                Member[]
  Message                                               Message[]
  Notification                                          Notification[]
  platformSuspension                                    PlatformSuspension[]
  premiumSeat                                           PremiumSeat?
  profile_profile_landlordIdTouser                      Profile[]                 @relation("profile_landlordIdTouser")
  profile_profile_userIdTouser                          Profile[]                 @relation("profile_userIdTouser")
  ownedProperties                                       Property[]                @relation("PropertyOwner")
  propertyListing_propertyListing_assignedAgentIdTouser PropertyListing[]         @relation("propertyListing_assignedAgentIdTouser")
  propertyListing_propertyListing_ownerIdTouser         PropertyListing[]         @relation("propertyListing_ownerIdTouser")
  RequestHistory                                        RequestHistory[]
  RequestNote                                           RequestNote[]
  residentDelegationsGranted                            ResidentDelegation[]      @relation("ResidentDelegation_owner")
  Resource                                              Resource[]
  serviceBooking                                        ServiceBooking[]          @relation("ServiceBookingToUser")
  serviceProviders                                      ServiceProvider[]
  soloSeat                                              SoloSeat[]
  standardSeat                                          StandardSeat[]
  receivedSupports                                      Support[]                 @relation("ReceivedSupports")
  sentSupports                                          Support[]                 @relation("SentSupports")
  ownedTenants                                          Tenant[]                  @relation("TenantOwner")
  UserAchievement                                       UserAchievement[]
  UserAchievementProgress                               UserAchievementProgress[]
  UserDevice                                            UserDevice[]
  UserKey                                               UserKey[]
  account                                               account[]
  passkey                                               passkey[]
  session                                               session[]
  twoFactor                                             twoFactor[]
  meetingProxiesOwner                                   MeetingProxy[]            @relation("MeetingProxyOwner")
  meetingProxiesProxy                                   MeetingProxy[]            @relation("MeetingProxyProxy")
  meetingProxiesApprover                                MeetingProxy[]            @relation("MeetingProxyApprover")
  securityAlertsTriggered                               SecurityAlert[]           @relation("SecurityAlertTriggeredBy")
  securityAlertsAcknowledged                            SecurityAlert[]           @relation("SecurityAlertAcknowledgedBy")
  securityAlertsResolved                                SecurityAlert[]           @relation("SecurityAlertResolvedBy")
  securityContactsCreated                               SecurityContact[]         @relation("SecurityContactCreatedBy")
  visitorsRequested                                     Visitor[]                 @relation("VisitorRequestedBy")
  accessRequestsResponded                               AccessRequest[]           @relation("AccessRequestRespondedBy")
  accessEventsActed                                     AccessEvent[]             @relation("AccessEventActor")
}

model Profile {
  id                            String               @id
  tenantId                      String
  householdId                   String
  displayName                   String
  profileAddress                String               @unique
  userId                        String?
  avatar                        String?
  isPublic                      Boolean              @default(true)
  showEmail                     Boolean              @default(true)
  showPhone                     Boolean              @default(true)
  occupantSince                 DateTime             @default(now())
  householdRole                 HouseholdRole        @default(OCCUPANT)
  leaseStartDate                DateTime?
  leaseEndDate                  DateTime?
  status                        ProfileStatus        @default(ACTIVE)
  organizationId                String?
  createdAt                     DateTime             @default(now())
  updatedAt                     DateTime             @default(now()) @updatedAt
  deletedAt                     DateTime?
  occupantImage                 String?
  rentalImage                   String?
  landlordId                    String?
  residencyType                 ResidencyType        @default(FAMILY)
  aliasAddressId                String?
  aliasAddress                  Address?             @relation(fields: [aliasAddressId], references: [id])
  household                     Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user_profile_landlordIdTouser user?                @relation("profile_landlordIdTouser", fields: [landlordId], references: [id])
  Tenant                        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user_profile_userIdTouser     user?                @relation("profile_userIdTouser", fields: [userId], references: [id])
  residentDelegations           ResidentDelegation[]
  vehicles                      Vehicle[]

  @@unique([householdId, profileAddress])
  @@index([householdId])
  @@index([landlordId])
  @@index([organizationId])
  @@index([userId])
  @@index([aliasAddressId])
  @@index([tenantId])
}

model Member {
  id             String       @id
  tenantId       String
  organizationId String
  userId         String
  role           String       @default("member")
  createdAt      DateTime
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user           user         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([tenantId])
}

model Organization {
  id         String       @id
  tenantId   String
  name       String
  slug       String       @unique
  logo       String?
  createdAt  DateTime
  metadata   String?
  invitation Invitation[]
  member     Member[]
  Tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
}

model Notification {
  id             String           @id
  tenantId       String
  userId         String
  title          String
  message        String
  type           NotificationType @default(info)
  link           String?
  read           Boolean          @default(false)
  createdAt      DateTime         @default(now())
  deletedAt      DateTime?
  senderId       String?
  readAt         DateTime?
  payload        Json?
  deliveryStatus String           @default("PENDING")
  category       String?
  Tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user           user             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}

model ServiceBooking {
  id            String                  @id
  tenantId      String
  listingId     String
  providerId    String
  userId        String
  date          DateTime                @db.Date
  startTime     String
  endTime       String
  price         Decimal?
  platformFee   Decimal?
  paymentStatus BookingPaymentStatus    @default(PENDING)
  status        ServiceBookingStatus    @default(PENDING_CONFIRMATION)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  deletedAt     DateTime?
  listing       CommunityServiceListing @relation("ServiceBookingToListing", fields: [listingId], references: [id], onDelete: Cascade)
  provider      ServiceProvider         @relation("ServiceBookingToProvider", fields: [providerId], references: [id], onDelete: Cascade)
  Tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user          user                    @relation("ServiceBookingToUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([listingId, date, startTime])
}

model AgentProfile {
  id               String    @id
  tenantId         String
  Tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  agentId          String    @unique
  agencyName       String?
  licenseNumber    String?
  experienceYears  Int       @default(0)
  specializations  String[]
  serviceAreas     String[]
  totalListings    Int       @default(0)
  activeListings   Int       @default(0)
  salesCompleted   Int       @default(0)
  avgSalePrice     Decimal?  @db.Decimal(12, 2)
  rating           Float     @default(0)
  reviewCount      Int       @default(0)
  commissionRate   Decimal?  @db.Decimal(5, 2)
  responseTime     Int       @default(24)
  isVerified       Boolean   @default(false)
  verificationDate DateTime?
  organizationId   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  deletedAt        DateTime?
  user             user      @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([isVerified])
  @@index([organizationId])
  @@index([rating])
  @@index([tenantId])
  reviews AgentReview[]
}

model AgentReview {
  id                String   @id
  tenantId          String
  Tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  agentProfileId    String
  agentProfile      AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  reviewerId        String
  reviewer          user     @relation("AgentReview_reviewerToUser", fields: [reviewerId], references: [id])
  rating            Int
  title             String?
  comment           String?
  serviceDate       DateTime?
  responseQuality   Int?
  isPublished       Boolean  @default(true)
  moderatedBy       String?
  moderatedAt       DateTime?
  createdAt         DateTime @default(now())
  deletedAt         DateTime?

  @@index([agentProfileId])
  @@index([tenantId])
  @@index([rating])
  @@index([reviewerId])
}

model PremiumSeat {
  id                   String                @id
  tenantId             String
  userId               String                @unique
  isActive             Boolean               @default(true)
  portfolioName        String?
  subscriptionTier     String                @default("basic")
  maxProperties        Int                   @default(5)
  platformAddress      String                @unique
  organizationId       String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now()) @updatedAt
  messageRetentionDays Int                   @default(30)
  tier                 String                @default("core")
  archivedAt           DateTime?
  status               SeatStatus            @default(ACTIVE)
  addressId            String?
  address              Address?              @relation(fields: [addressId], references: [id])
  Tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                 user                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyPremiumSeats PropertyPremiumSeat[]

  @@index([organizationId])
  @@index([userId])
  @@index([addressId])
  @@index([tenantId])
}

model SoloSeat {
  id                  String       @id
  tenantId            String
  userId              String
  platformAddress     String       @unique
  propertyId          String?
  seatType            SoloSeatType
  isComplimentary     Boolean      @default(false)
  linkedFromProfileId String?
  organizationId      String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @default(now()) @updatedAt
  archivedAt          DateTime?
  status              SeatStatus   @default(ACTIVE)
  addressId           String?
  address             Address?     @relation(fields: [addressId], references: [id])
  property            Property?    @relation(fields: [propertyId], references: [id])
  Tenant              Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user                user         @relation(fields: [userId], references: [id])

  @@index([propertyId])
  @@index([organizationId])
  @@index([userId])
  @@index([addressId])
  @@index([tenantId])
}

model StandardSeat {
  id              String     @id
  tenantId        String
  userId          String
  propertyId      String
  isPrimaryOwner  Boolean    @default(true)
  platformAddress String     @unique
  organizationId  String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now()) @updatedAt
  archivedAt      DateTime?
  status          SeatStatus @default(ACTIVE)
  addressId       String?
  address         Address?   @relation(fields: [addressId], references: [id])
  property        Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  Tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user            user       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles        Vehicle[]

  @@unique([userId, propertyId])
  @@index([propertyId])
  @@index([organizationId])
  @@index([userId])
  @@index([addressId])
  @@index([tenantId])
}

model UserKey {
  id        String    @id @default(uuid())
  userId    String
  publicKey String
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserDevice {
  id         String   @id @default(uuid())
  userId     String
  publicKey  String
  deviceName String
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PlatformModule {
  id             String         @id @default(uuid())
  key            String         @unique
  label          String
  minTier        Tier           @default(STANDARD)
  defaultEnabled Boolean        @default(false)
  description    String?
  createdAt      DateTime       @default(now())
  tenantModules  TenantModule[]
}

model TenantModule {
  id        String         @id @default(uuid())
  tenantId  String
  moduleKey String
  enabled   Boolean        @default(false)
  config    Json?
  enabledAt DateTime?
  module    PlatformModule @relation(fields: [moduleKey], references: [key])
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
  @@index([moduleKey])
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum CredentialType {
  EMAIL
  PASSKEY
  NOSTR
  LNURL
  OIDC
}

model Identity {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  credentials Credential[]

  @@map("identities")
}

model Credential {
  id            String         @id @default(uuid())
  identityId    String
  identity      Identity       @relation(fields: [identityId], references: [id])
  type          CredentialType
  email         String?
  publicKey     String?
  fingerprint   String?
  metadata      Json?          @db.JsonB
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  meetingProxies MeetingProxy[] @relation("MeetingProxyToCredential")

  @@index([identityId])
  @@map("credentials")
}

model Setting {
  id            String           @id
  tenantId      String
  Tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  key           String
  value         String
  type          SettingValueType @default(STRING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt
  schemaVersion Int              @default(1)
  deletedAt     DateTime?

  @@unique([tenantId, key])
  @@index([tenantId])
}

model TenantSetup {
  id                String         @id @default(cuid())
  tenantId          String         @unique
  completionPercent Int            @default(0)
  completedSections String[]       @default([])
  launchedAt        DateTime?
  lastViewedAt      DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @default(now()) @updatedAt
  deletedAt         DateTime?
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  missions          SetupMission[]
  settings          SetupSetting[]

  @@index([tenantId])
}

model SetupMission {
  id            String      @id @default(cuid())
  tenantSetupId String
  section       String
  missionKey    String
  title         String
  description   String?
  isRequired    Boolean     @default(false)
  isCompleted   Boolean     @default(false)
  completedAt   DateTime?
  sortOrder     Int         @default(0)
  metadata      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  deletedAt     DateTime?
  tenantSetup   TenantSetup @relation(fields: [tenantSetupId], references: [id], onDelete: Cascade)

  @@unique([tenantSetupId, missionKey])
  @@index([tenantSetupId, section])
}

model SetupSetting {
  id            String      @id @default(cuid())
  tenantSetupId String
  key           String
  value         Json
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  deletedAt     DateTime?
  tenantSetup   TenantSetup @relation(fields: [tenantSetupId], references: [id], onDelete: Cascade)

  @@unique([tenantSetupId, key])
  @@index([tenantSetupId])
}

model Property {
  id                  String                @id @default(uuid())
  tenantId            String
  platformAddress     String
  street              String
  unit                String
  ownerId             String?
  homeImage           String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  deletedAt           DateTime?
  addressId           String?
  agentAccess         AgentAccess[]
  Booking             Booking[]
  households          Household[]
  MaintenanceRequest  MaintenanceRequest[]
  address             Address?              @relation(fields: [addressId], references: [id])
  owner               user?                 @relation("PropertyOwner", fields: [ownerId], references: [id])
  Tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  propertyListing     PropertyListing[]
  PropertyPremiumSeat PropertyPremiumSeat[]
  residentDelegations ResidentDelegation[]
  soloSeat            SoloSeat[]
  SecurityAlert       SecurityAlert[]
  standardSeat        StandardSeat[]
  Visitor             Visitor[]
  AccessRequest       AccessRequest[]
  AccessEvent         AccessEvent[]
  joinRequests        PropertyJoinRequest[]

  @@index([ownerId])
  @@index([addressId])
  @@index([tenantId])
  @@unique([tenantId, street, unit])
}

model Household {
  id             String          @id @default(uuid())
  tenantId       String
  propertyId     String
  organizationId String?
  occupancyType  OccupancyType   @default(OWNER_OCCUPIED)
  status         HouseholdStatus @default(ACTIVE)
  moveInDate     DateTime?
  moveOutDate    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  Tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  profiles       Profile[]

  @@index([propertyId])
  @@index([organizationId])
  @@index([tenantId])
}

model PropertyJoinRequest {
  id                     String            @id @default(uuid())
  tenantId               String
  propertyId             String?
  propertyNumberRaw      String
  relationshipType       RelationshipType
  requestedName          String
  requestedSurname       String?
  requestedEmail         String
  requestedPhone         String?
  rulesAcceptedAt        DateTime?
  status                 JoinRequestStatus @default(PENDING)
  reviewedByUserId       String?
  reviewedAt             DateTime?
  rejectionReason        String?
  resultingInvitationId  String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  deletedAt              DateTime?

  Tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  property Property?  @relation(fields: [propertyId], references: [id])
  vehicles Vehicle[]

  @@index([tenantId, status])
  @@index([propertyId])
  @@index([requestedEmail])
}

model Vehicle {
  id             String    @id @default(uuid())
  tenantId       String
  joinRequestId  String?
  profileId      String?
  standardSeatId String?
  make           String?
  model          String?
  color          String?
  registration   String
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  Tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  joinRequest  PropertyJoinRequest?  @relation(fields: [joinRequestId], references: [id], onDelete: Cascade)
  profile      Profile?              @relation(fields: [profileId], references: [id])
  standardSeat StandardSeat?         @relation(fields: [standardSeatId], references: [id])

  @@index([tenantId])
  @@index([joinRequestId])
  @@index([profileId])
  @@index([registration])
}

model PropertyListing {
  id                                         String        @id
  tenantId                                   String
  propertyId                                 String
  ownerId                                    String
  listingType                                ListingType
  title                                      String
  description                                String?
  price                                      Decimal?      @db.Decimal(10, 2)
  currency                                   String        @default("ZAR")
  bedrooms                                   Int?
  bathrooms                                  Int?
