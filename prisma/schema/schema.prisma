  metadata  Json?
  createdAt DateTime @default(now())
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user      user?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([contentId])
  @@index([contentId, createdAt])
  @@index([action])
}

model Support {
