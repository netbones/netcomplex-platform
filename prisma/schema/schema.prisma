// Booking model moved to prisma/schema/amenity.prisma

model MaintenanceRequest {
  id                 String                    @id
  tenantId           String
  Tenant             Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  propertyId         String?
  userId             String
  category           String
  priority           Priority
  description        String
  status             RequestStatus             @default(SUBMITTED)
  images             String[]
  assignedTo         String?
  vendor             String?
  scheduledDate      DateTime?
  estimatedCost      Decimal?                  @db.Decimal(10, 2)
  actualCost         Decimal?                  @db.Decimal(10, 2)
  resolution         String?
  completedAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @default(now()) @updatedAt
  ticketNumber       String
  preferredDate      DateTime?
  preferredTime      String?
  assignedTeamId     String?
  assignedProviderId String?
  routingType        MaintenanceRouting        @default(HOA)
  landlordId         String?
  internalNotes      InternalMaintenanceNote[]
  assignedProvider   ServiceProvider?          @relation("ProviderAssignments", fields: [assignedProviderId], references: [id])
  assignedTeam       MaintenanceTeam?          @relation("TeamAssignments", fields: [assignedTeamId], references: [id])
  landlord           user?                     @relation("MaintenanceRequest_landlord", fields: [landlordId], references: [id])
  property           Property?                 @relation(fields: [propertyId], references: [id])
  user               user                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  histories          RequestHistory[]
  notes              RequestNote[]

  @@index([tenantId])
  @@index([assignedTeamId])
  @@index([assignedProviderId])
  @@index([propertyId])
  @@index([userId])
  @@index([routingType])
  @@index([landlordId])
}

model MaintenanceTeam {
  id          String                  @id @default(uuid())
  tenantId    String
  Tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name        String
  trade       String
  contactName String?
  isActive    Boolean                 @default(true)
  createdAt   DateTime                @default(now())
