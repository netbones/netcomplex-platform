// ── Tenant — Core multi-tenant identity ──
// Back-link arrays required by Prisma's bidirectional @relation constraint.
// Batch A: 27 back-links (applied). Batches B/C/D will add ~59 more.
// DO NOT use prisma.tenant.findUnique({ include: {...} }) — use Drizzle child-table-first queries.

model Tenant {
  id                      String                    @id @default(uuid())
  name                    String
  slug                    String                    @unique
  customDomain            String?                   @unique
  logoUrl                 String?
  faviconUrl              String?
  primaryColor            String                    @default("#4F46E5")
  accentColor             String?
  secondaryColor          String?
  fontFamily              String?
  tagline                 String?
  description             String?
  address                 String?
  telephone               String?
  email                   String?
  governanceLabel         String?
  customCss               String?
  active                  Boolean                   @default(true)
  subscriptionTier        String                    @default("basic")
  modules                 Json?
  maxPages                Int                       @default(5)
  pageCount               Int                       @default(0)
  featureFlags            Json                      @default("{}")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime?
  tier                    Tier                      @default(STANDARD)
  ownerId                 String?

  owner                   user?                     @relation("TenantOwner", fields: [ownerId], references: [id])

  // ── Batch A back-links (introspected from DB) ──
  Album                   Album[]
  Announcement            Announcement[]
  Booking                 Booking[]
  Content                 Content[]
  ContentLike             ContentLike[]
  Comment                 Comment[]
  CommentReport           CommentReport[]
  CommentVote             CommentVote[]
  Conversation            Conversation[]
  ConversationParticipant ConversationParticipant[]
  Event                   Event[]
  EventAttendee           EventAttendee[]
  Group                   Group[]
  GroupMember             GroupMember[]
  GroupMembershipRequest  GroupMembershipRequest[]
  Household               Household[]
  Invitation              Invitation[]
  Member                  Member[]
  Message                 Message[]
  Notification            Notification[]
  Organization            Organization[]
  PremiumSeat             PremiumSeat[]
  Profile                 Profile[]
  Property                Property[]
  PropertyListing         PropertyListing[]
  PropertyPremiumSeat     PropertyPremiumSeat[]
  Resource                Resource[]
  ServiceBooking          ServiceBooking[]
  SoloSeat                SoloSeat[]
  StandardSeat            StandardSeat[]
  PropertyJoinRequest     PropertyJoinRequest[]
  Vehicle                 Vehicle[]

  // ── Batch D back-links (Admin & Agents + Achievements & Disputes + Address & AI) ──
  Address                 Address[]
  AgentAccess             AgentAccess[]
  AgentToken              AgentToken[]
  AiUsageEvent            AiUsageEvent[]
  Bursary                 Bursary[]
  DelegationAction        DelegationAction[]
  DisputeCase             DisputeCase[]
  DisputeEvidence         DisputeEvidence[]
  DisputeEvent            DisputeEvent[]
  DisputeMessage          DisputeMessage[]
  DisputeNotification     DisputeNotification[]
  Handle                  Handle[]
  PlatformSuspension      PlatformSuspension[]
  ResidentDelegation      ResidentDelegation[]
  Setting                 Setting[]
  SubscriptionTier        SubscriptionTier[]
  TenantAiUsage           TenantAiUsage[]
  UserAchievement         UserAchievement[]
  UserAchievementProgress UserAchievementProgress[]

  // ── Batch C back-links (Surveys & Merits + dWallet & Data) ──
  AgentProfile            AgentProfile[]
  CommunityMerit          CommunityMerit[]
  Competition             Competition[]
  DataConsent             DataConsent[]
  DataRevenueStream       DataRevenueStream[]
  DataShareBatch          DataShareBatch[]
  DWallet                 DWallet[]
  ExternalSurvey          ExternalSurvey[]
  PayoutRequest           PayoutRequest[]
  Question                Question[]
  Response                Response[]
  Survey                  Survey[]
  SurveySection           SurveySection[]
  WalletTransaction       WalletTransaction[]

  // ── Amenities ──
  Amenity                 Amenity[]

  // ── Security ──
  SecurityAlert           SecurityAlert[]
  SecurityContact         SecurityContact[]

  // ── Access Control ──
  Visitor                 Visitor[]
  AccessCode              AccessCode[]
  AccessRequest           AccessRequest[]
  Gate                    Gate[]
  AccessEvent             AccessEvent[]

  // ── Batch B back-links (Maintenance & Providers + Billing & Commerce) ──
  BillingAdjustment       BillingAdjustment[]
  BillingEvent            BillingEvent[]
  BillingPlan             BillingPlan[]
  SeatPlan                SeatPlan[]
  SeatSubscription        SeatSubscription[]
  BursaryField            BursaryField[]
  CommunityServiceInquiry   CommunityServiceInquiry[]
  CommunityServiceListing   CommunityServiceListing[]
  CommunityServiceReview    CommunityServiceReview[]
  Coupon                  Coupon[]
  CouponRedemption        CouponRedemption[]
  MaintenanceCategory     MaintenanceCategory[]
  MaintenanceRequest      MaintenanceRequest[]
  MaintenanceTeam         MaintenanceTeam[]
  MaintenanceTeamMember   MaintenanceTeamMember[]
  PaymentTransaction      PaymentTransaction[]
  ProviderCharge          ProviderCharge[]
  ProviderInvoice         ProviderInvoice[]
  ProviderLegalAgreement  ProviderLegalAgreement[]
  ProviderMerit           ProviderMerit[]
  ProviderReputation      ProviderReputation[]
  ProviderSubscription    ProviderSubscription[]
  ProviderVerification    ProviderVerification[]
  ProviderDueDiligenceWorkflow ProviderDueDiligenceWorkflow[]
  RevenueRecord           RevenueRecord[]
  ServiceProvider         ServiceProvider[]
  Support                 Support[]
  TenantInvoice           TenantInvoice[]
  TenantPayment           TenantPayment[]
  TenantSubscription      TenantSubscription[]

  MediaUpload             MediaUpload[]
  assistSessions          AssistSession[]
  tenantAchievements      TenantAchievement[]
  tenantModules           TenantModule[]
  tenantSetup             TenantSetup?
  tenantFeatureFlags      TenantFeatureFlag[]
  meetingProxies          MeetingProxy[]
  AgentReview             AgentReview[]

  @@index([ownerId])
}

model TenantFeatureFlag {
  id         String    @id @default(uuid())
  tenantId   String
  featureKey String
  enabled    Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, featureKey])
  @@index([tenantId])
}
